<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<!-- Lié à styleDash.css pour le thème du tableau de bord -->
<?import javafx.scene.layout.FlowPane?>
<AnchorPane style="-fx-background-color: transparent;" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="projet.controllers.AddReservationController">

    <children>
        <VBox alignment="CENTER" fillWidth="false" spacing="20" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

            <!-- Conteneur de la carte blanche -->
            <VBox alignment="CENTER" spacing="20" styleClass="form-card">

                <Label styleClass="form-title" text="📅 Nouvelle Réservation" />

                <GridPane hgap="20.0" vgap="15.0">
                    <columnConstraints>
                        <!-- Colonne des Labels -->
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="120.0" prefWidth="130.0" />
                        <!-- Colonne des Champs -->
                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="300.0" />
                    </columnConstraints>

                    <!-- LIGNE 0: Nom du Client -->
                    <Label styleClass="form-label" text="Nom du Client :" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="tfNom" promptText="Prénom et Nom" styleClass="form-input" GridPane.columnIndex="1" GridPane.rowIndex="0" />


                    <!-- LIGNE 2: Date de Réservation -->
                    <Label styleClass="form-label" text="Date de Réservation :" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <DatePicker fx:id="dpDateReservation" maxWidth="1.7976931348623157E308" styleClass="form-input" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <!-- LIGNE 3: Mode de Paiement -->
                    <Label styleClass="form-label" text="Mode de Paiement :" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    <TextField fx:id="tfModePaiement" promptText="Choisir une méthode..." maxWidth="1.7976931348623157E308" styleClass="form-input" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                    <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                    </rowConstraints>
                </GridPane>
                <VBox fx:id="seatMapContainer" spacing="12" alignment="CENTER"
                      visible="false" managed="false"
                      style="-fx-background-color: #1a1a2e; -fx-background-radius: 12; -fx-padding: 20;">

                    <!-- Plane front indicator -->
                    <Label text="✈  AVANT DE L'AVION  ✈"
                           style="-fx-text-fill: #aaaaaa; -fx-font-size: 11px; -fx-font-family: 'Courier New';" />
                    <Label text="━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                           style="-fx-text-fill: #444466; -fx-font-size: 10px;" />

                    <!-- Legend -->
                    <FlowPane hgap="16" vgap="6" alignment="CENTER">
                        <Label text="🟢 Disponible"
                               style="-fx-text-fill: #cccccc; -fx-font-size: 11px;" />
                        <Label text="🔴 Occupé"
                               style="-fx-text-fill: #cccccc; -fx-font-size: 11px;" />
                        <Label text="🔵 Sélectionné"
                               style="-fx-text-fill: #cccccc; -fx-font-size: 11px;" />
                    </FlowPane>

                    <!-- Seat grid — populated dynamically in the controller -->
                    <FlowPane fx:id="seatGrid" hgap="8" vgap="8" alignment="CENTER"
                              prefWrapLength="400" />

                    <!-- Shows which seat is currently selected -->
                    <Label fx:id="lblSelectedSeat" text="Aucun siège sélectionné"
                           style="-fx-text-fill: #7eb8f7; -fx-font-size: 13px; -fx-font-style: italic;" />
                </VBox>
                <!-- Conteneur pour les messages d'erreur -->
                <VBox fx:id="errorContainer" alignment="CENTER" spacing="2" />

                <!-- Bouton d'action -->
                <Button  styleClass="btn-submit" onAction="#AddReservation" text="✔ Créer la Réservation" />
            </VBox>
        </VBox>
    </children>
</AnchorPane>