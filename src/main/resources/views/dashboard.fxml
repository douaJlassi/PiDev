<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.DashboardController"
            styleClass="dashboard-root"
            stylesheets="@../styles/dashboard.css">

    <!-- Top Navigation Bar -->
    <top>
        <HBox styleClass="nav-bar" alignment="CENTER_LEFT" spacing="20">
            <padding>
                <Insets top="12" right="30" bottom="12" left="30"/>
            </padding>

            <!-- Logo -->
            <ImageView fx:id="logoImage" fitHeight="45" preserveRatio="true">
                <image>
                    <Image url="@../images/logo.png"/>
                </image>
            </ImageView>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- View Toggle -->
            <HBox spacing="8" alignment="CENTER" styleClass="view-toggle-container">
                <Button fx:id="gridViewBtn" text="⊞ Grid" styleClass="view-toggle-btn, active-view" onAction="#switchToGridView"/>
                <Button fx:id="listViewBtn" text="☰ Feed" styleClass="view-toggle-btn" onAction="#switchToListView"/>
            </HBox>

            <!-- Search Bar -->
            <TextField fx:id="searchField" promptText="🔍 Search posts..." styleClass="search-field" prefWidth="250"/>

            <Button fx:id="createPostBtn" text="+ Create Post" styleClass="primary-btn" onAction="#showCreatePostDialog"/>
            <Button fx:id="refreshBtn" text="⟳" styleClass="icon-btn" onAction="#refreshPosts"/>
        </HBox>
    </top>

    <!-- Main Content Area -->
    <center>
        <StackPane fx:id="contentContainer">
            <VBox fx:id="feedView">
                <ScrollPane fx:id="postsScrollPane" styleClass="posts-scroll-pane" fitToWidth="true" VBox.vgrow="ALWAYS">
                    <StackPane>
                        <FlowPane fx:id="postsGrid" styleClass="posts-grid" hgap="24" vgap="24" alignment="TOP_CENTER" />
                        <VBox fx:id="postsList" styleClass="posts-list" spacing="20" alignment="TOP_CENTER" visible="false" managed="false" />
                    </StackPane>
                </ScrollPane>
            </VBox>

            <VBox fx:id="detailView" visible="false" managed="false" styleClass="detail-view-container">
                <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 15; -fx-background-color: white; -fx-border-color: #e4e6eb; -fx-border-width: 0 0 1 0;">
                    <Button text="← Back to Feed" onAction="#handleBackToFeed" styleClass="secondary-btn" />
                    <Label text="Post Discussion" styleClass="post-author-name" style="-fx-font-size: 18px;" />
                </HBox>

                <HBox VBox.vgrow="ALWAYS">
                    <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS" styleClass="posts-scroll-pane">
                        <VBox fx:id="detailPostContainer" alignment="TOP_CENTER" spacing="20" style="-fx-padding: 30;" />
                    </ScrollPane>

                    <VBox prefWidth="400" minWidth="400" styleClass="comments-sidebar">
                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="posts-scroll-pane">
                            <VBox fx:id="detailCommentsList" spacing="12" style="-fx-padding: 15;" />
                        </ScrollPane>

                        <VBox spacing="10" styleClass="comment-input-area">
                            <TextArea fx:id="detailCommentInput" promptText="Write a comment..." prefHeight="80" wrapText="true" styleClass="dialog-text-area" />
                            <Button fx:id="submitCommentBtn" text="Post Comment" onAction="#handleDetailCommentSubmit" styleClass="primary-btn" maxWidth="Infinity" />
                        </VBox>
                    </VBox>
                </HBox>
            </VBox>
        </StackPane>
    </center>


</BorderPane>
