<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            styleClass="post-detail-view"
            stylesheets="@../styles/dashboard.css">

    <!-- ===== TOP BAR ===== -->
    <top>
        <HBox styleClass="detail-top-bar" alignment="CENTER_LEFT" spacing="12">
            <padding><Insets top="14" right="20" bottom="14" left="20"/></padding>

            <Button fx:id="closeBtn" styleClass="close-detail-btn" text="X" onAction="#onClose"/>

            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Post Details" styleClass="detail-title"/>
            <Region HBox.hgrow="ALWAYS"/>

            <!-- Placeholder to balance the close button width -->
            <Region prefWidth="36"/>
        </HBox>
    </top>

    <!-- ===== SPLIT VIEW ===== -->
    <center>
        <HBox styleClass="split-view">

            <!-- LEFT — post content -->
            <VBox fx:id="leftPanel" styleClass="post-content-panel" HBox.hgrow="ALWAYS">
                <ScrollPane fitToWidth="true" styleClass="posts-scroll-pane" VBox.vgrow="ALWAYS">
                    <VBox fx:id="postContentBox" spacing="20">
                        <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>

                        <!-- Author row -->
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Circle fx:id="authorAvatar" styleClass="avatar" radius="24"/>
                            <VBox spacing="4">
                                <Label fx:id="authorNameLabel" styleClass="detail-author-name" text="Author"/>
                                <Label fx:id="dateLabel" styleClass="post-meta" text="Date"/>
                            </VBox>
                        </HBox>

                        <!-- Place tag (hidden when empty) -->
                        <Label fx:id="placeLabel" styleClass="post-place-tag"
                               text="" visible="false" managed="false"/>

                        <!-- PHASE 4C: Weather badge (populated programmatically) -->
                        <HBox fx:id="weatherBadge" styleClass="weather-badge" spacing="6"
                              alignment="CENTER_LEFT" visible="false" managed="false" maxWidth="-Infinity">
                            <ImageView fx:id="weatherIcon" styleClass="weather-icon"
                                       fitWidth="32" fitHeight="32" preserveRatio="true"/>
                            <VBox spacing="2">
                                <Label fx:id="weatherText" styleClass="weather-text" text=""/>
                                <Label fx:id="weatherDescription" styleClass="post-meta" text=""/>
                            </VBox>
                        </HBox>

                        <!-- Full post text -->
                        <Label fx:id="postContentLabel" styleClass="detail-post-text"
                               wrapText="true" text="Post content"/>

                        <!-- Post image (hidden when no image) -->
                        <VBox fx:id="imageContainer" visible="false" managed="false">
                            <ImageView fx:id="postImage"
                                       fitWidth="580" preserveRatio="true" smooth="true"/>
                        </VBox>

                        <!-- Stats row -->
                        <HBox fx:id="statsBar" styleClass="post-stats" alignment="CENTER_LEFT" spacing="16">
                            <Label fx:id="likesStatLabel"    styleClass="post-stats-text" text="" visible="false" managed="false"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="commentsStatLabel" styleClass="post-stats-text" text="" visible="false" managed="false"/>
                        </HBox>

                        <!-- Action buttons -->
                        <HBox styleClass="post-actions" alignment="CENTER" spacing="8">
                            <Button fx:id="likeBtn"  styleClass="action-btn" text="Like"
                                    maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#onLikeClicked"/>
                            <Button fx:id="commentBtn2" styleClass="action-btn" text="Comment"
                                    maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#onCommentFocusClicked"/>
                        </HBox>

                    </VBox>
                </ScrollPane>
            </VBox>

            <!-- RIGHT — comments panel -->
            <VBox fx:id="rightPanel" styleClass="comments-panel" prefWidth="380" minWidth="320" maxWidth="420">

                <!-- Header -->
                <HBox styleClass="comments-panel-header" alignment="CENTER_LEFT" spacing="6">
                    <padding><Insets top="16" right="20" bottom="14" left="20"/></padding>
                    <Label text="Comments" styleClass="comments-panel-title"/>
                    <Label fx:id="commentCountLabel" styleClass="comments-count-label" text="(0)"/>
                </HBox>

                <!-- Comment input -->
                <HBox fx:id="commentInputRow" styleClass="comment-input-row"
                      alignment="CENTER_LEFT" spacing="10">
                    <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>
                    <Circle styleClass="avatar" radius="15"/>
                    <TextField fx:id="commentTextField" styleClass="comment-text-field"
                               promptText="Write a comment..."
                               HBox.hgrow="ALWAYS" onAction="#onCommentSubmit"/>
                    <Button fx:id="commentPostBtn" styleClass="primary-btn"
                            text="Post" onAction="#onCommentSubmit" disable="true"/>
                </HBox>

                <!-- Scrollable comments list -->
                <ScrollPane fitToWidth="true" styleClass="posts-scroll-pane" VBox.vgrow="ALWAYS">
                    <VBox fx:id="commentsList" styleClass="comments-list" spacing="10">
                        <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>
                    </VBox>
                </ScrollPane>

            </VBox>

        </HBox>
    </center>

</BorderPane>
