<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.CommentItemController"
      spacing="6" styleClass="comment-item"
      stylesheets="@../styles/dashboard.css">

    <padding><Insets top="10" right="12" bottom="10" left="12"/></padding>

    <!-- Top row: avatar + name + time + content -->
    <HBox spacing="10" alignment="TOP_LEFT">

        <Circle fx:id="avatarCircle" styleClass="avatar" radius="15"/>

        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label fx:id="usernameLabel" styleClass="comment-username" text="User"/>
                <Label fx:id="timeLabel"     styleClass="comment-time"     text="Just now"/>
            </HBox>
            <Label fx:id="contentLabel" styleClass="comment-content" wrapText="true" text="Comment content"/>
        </VBox>

    </HBox>

    <!-- Owner actions (hidden by default, shown in controller if owner) -->
    <HBox fx:id="ownerActions" spacing="12" alignment="CENTER_LEFT"
          visible="false" managed="false">
        <padding><Insets left="40"/></padding>
        <Button fx:id="editBtn"   styleClass="comment-action-edit"   text="Edit"   onAction="#onEditClicked"/>
        <Label  styleClass="comment-action-dot" text="·"/>
        <Button fx:id="deleteBtn" styleClass="comment-action-delete" text="Delete" onAction="#onDeleteClicked"/>
    </HBox>

</VBox>
