<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.AgencyDashboardController"
            stylesheets="@../styles/dashboard.css,@../styles/agency.css"
            styleClass="agency-root">

    <top>
        <HBox styleClass="agency-header" alignment="CENTER_LEFT" spacing="16" prefHeight="64">
            <padding><Insets top="0" right="28" bottom="0" left="28"/></padding>
            <StackPane styleClass="agency-logo-mark" prefWidth="40" prefHeight="40">
                <Label text="R" styleClass="agency-logo-letter"/>
            </StackPane>
            <VBox spacing="1" alignment="CENTER_LEFT">
                <Label text="REHLETNA" styleClass="agency-brand-name"/>
                <Label text="Back Office" styleClass="agency-brand-sub"/>
            </VBox>
            <Region styleClass="agency-header-divider" prefWidth="1" prefHeight="32"/>
            <VBox spacing="2" alignment="CENTER_LEFT">
                <Label text="AGENCY" styleClass="agency-header-eyebrow"/>
                <Label fx:id="agencyNameLabel" text="—" styleClass="agency-header-name"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button styleClass="agency-icon-btn" text="&#8635;" onAction="#onRefresh"/>
            <Button fx:id="themeToggleBtn" styleClass="agency-theme-btn" text="Dark Mode" onAction="#toggleTheme"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="agency-scroll">
            <VBox styleClass="agency-body" alignment="TOP_CENTER">
                <VBox styleClass="agency-content-column" maxWidth="960" alignment="TOP_LEFT">
                    <VBox.margin><Insets top="28" right="0" bottom="32" left="0"/></VBox.margin>

                    <HBox spacing="16" alignment="CENTER_LEFT">
                        <VBox styleClass="stat-card stat-card-pending" spacing="5" prefWidth="200">
                            <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
                            <Label text="PENDING" styleClass="stat-label"/>
                            <Label fx:id="pendingCount" text="0" styleClass="stat-number"/>
                            <Label text="Awaiting review" styleClass="stat-sub"/>
                        </VBox>
                        <VBox styleClass="stat-card stat-card-approved" spacing="5" prefWidth="200">
                            <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
                            <Label text="APPROVED" styleClass="stat-label"/>
                            <Label fx:id="approvedCount" text="0" styleClass="stat-number"/>
                            <Label text="Live on platform" styleClass="stat-sub"/>
                        </VBox>
                        <VBox styleClass="stat-card stat-card-rejected" spacing="5" prefWidth="200">
                            <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
                            <Label text="REJECTED" styleClass="stat-label"/>
                            <Label fx:id="rejectedCount" text="0" styleClass="stat-number"/>
                            <Label text="Did not pass review" styleClass="stat-sub"/>
                        </VBox>
                    </HBox>

                    <HBox styleClass="agency-filter-bar" alignment="CENTER_LEFT" spacing="8">
                        <VBox.margin><Insets top="20" bottom="16"/></VBox.margin>
                        <Label text="VIEW:" styleClass="filter-bar-label"/>
                        <fx:define><ToggleGroup fx:id="filterGroup"/></fx:define>
                        <ToggleButton fx:id="allTab"      text="All"      styleClass="filter-tab" toggleGroup="$filterGroup" selected="true" onAction="#onFilterChanged"/>
                        <ToggleButton fx:id="pendingTab"  text="Pending"  styleClass="filter-tab" toggleGroup="$filterGroup" onAction="#onFilterChanged"/>
                        <ToggleButton fx:id="approvedTab" text="Approved" styleClass="filter-tab" toggleGroup="$filterGroup" onAction="#onFilterChanged"/>
                        <ToggleButton fx:id="rejectedTab" text="Rejected" styleClass="filter-tab" toggleGroup="$filterGroup" onAction="#onFilterChanged"/>
                    </HBox>

                    <VBox fx:id="submissionList" styleClass="agency-submission-list" spacing="12"/>

                </VBox>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
