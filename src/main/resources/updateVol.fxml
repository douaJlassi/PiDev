<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<!-- Linked to styleDash.css for the Dashboard Theme -->
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.image.ImageView?>
<AnchorPane style="-fx-background-color: transparent;" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="projet.controllers.UpdateVolController">

    <children>
        <VBox alignment="CENTER" fillWidth="false" spacing="20" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

            <!-- White Card Container -->
            <VBox alignment="CENTER" spacing="20" styleClass="form-card">

                <!-- Title changed to reflect Update -->
                <Label styleClass="form-title" text="✈ Modifier un Vol" />

                <GridPane hgap="20.0" vgap="15.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="80.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="200.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="80.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="200.0" />
                    </columnConstraints>

                    <!-- ROW 0: Nom -->
                    <Label styleClass="form-label" text="Nom :" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="tfNom" promptText="Nom du vol" styleClass="form-input" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <!-- ROW 1: Description -->
                    <Label styleClass="form-label" text="Description :" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <TextArea fx:id="taDescription" prefRowCount="3" promptText="Détails..." styleClass="form-input" wrapText="true" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="1" />

                    <!-- ROW 2: Prix & Disponibilité -->
                    <Label styleClass="form-label" text="Prix :" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <TextField fx:id="tfPrix" promptText="0.00" styleClass="form-input" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <Label styleClass="form-label" text="Disponibilité :" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                    <CheckBox fx:id="cbDisponibilite" text="Disponible" GridPane.columnIndex="3" GridPane.rowIndex="2" />

                    <!-- ROW 3: Capacité & Numéro -->
                    <Label styleClass="form-label" text="Capacité :" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    <TextField fx:id="tfCapacite" promptText="Nb Sièges" styleClass="form-input" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                    <Label styleClass="form-label" text="Numéro Vol :" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                    <TextField fx:id="tfNumeroVol" promptText="Code Vol" styleClass="form-input" GridPane.columnIndex="3" GridPane.rowIndex="3" />

                    <!-- ROW 4: Villes -->
                    <Label styleClass="form-label" text="Ville Départ :" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                    <TextField fx:id="tfVilleDepart" styleClass="form-input" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                    <Label styleClass="form-label" text="Ville Arrivée :" GridPane.columnIndex="2" GridPane.rowIndex="4" />
                    <TextField fx:id="tfVilleArrivee" styleClass="form-input" GridPane.columnIndex="3" GridPane.rowIndex="4" />

                    <!-- ROW 5: Dates -->
                    <Label styleClass="form-label" text="Date Départ :" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                    <DatePicker fx:id="dpDateDepart" maxWidth="1.7976931348623157E308" styleClass="form-input" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                    <Label styleClass="form-label" text="Date Arrivée :" GridPane.columnIndex="2" GridPane.rowIndex="5" />
                    <DatePicker fx:id="dpDateArrivee" maxWidth="1.7976931348623157E308" styleClass="form-input" GridPane.columnIndex="3" GridPane.rowIndex="5" />
                    <!-- ROW 6: Photo -->
                    <Label styleClass="form-label" text="Photo :" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                    <HBox alignment="CENTER_LEFT" spacing="10" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="6">
                        <Button fx:id="btnChoisirPhoto" onAction="#choisirPhoto" styleClass="btn-submit" text="📁 Choisir une image" />
                        <ImageView fx:id="imgPreview" fitHeight="60.0" fitWidth="80.0" preserveRatio="true" />
                    </HBox>
                    <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                    </rowConstraints>

                </GridPane>

                <!-- Error Messages Container -->
                <VBox alignment="CENTER_LEFT" spacing="2">
                    <Label fx:id="lblErrorNom" managed="false" styleClass="error-label" visible="false" wrapText="true" />
                    <Label fx:id="lblErrorDescription" managed="false" styleClass="error-label" visible="false" wrapText="true" />
                    <Label fx:id="lblErrorPrix" managed="false" styleClass="error-label" visible="false" wrapText="true" />
                    <Label fx:id="lblErrorCapacite" managed="false" styleClass="error-label" visible="false" wrapText="true" />
                    <Label fx:id="lblErrorNumeroVol" managed="false" styleClass="error-label" visible="false" wrapText="true" />
                    <Label fx:id="lblErrorVilleDepart" managed="false" styleClass="error-label" visible="false" wrapText="true" />
                    <Label fx:id="lblErrorVilleArrive" managed="false" styleClass="error-label" visible="false" wrapText="true" />
                    <Label fx:id="lblErrorDateDepart" managed="false" styleClass="error-label" visible="false" wrapText="true" />
                    <Label fx:id="lblErrorDateArrive" managed="false" styleClass="error-label" visible="false" wrapText="true" />
                    <Label fx:id="lblErrorPhoto" managed="false" styleClass="error-label" visible="false" wrapText="true" />
                </VBox>

                <!-- Update Button -->
                <Button onAction="#handleUpdate" styleClass="btn-submit" text="✔ Modifier" />

            </VBox>
        </VBox>
    </children>
</AnchorPane>