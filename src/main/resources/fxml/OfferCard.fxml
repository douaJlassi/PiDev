<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>


<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.OfferCardController"
      spacing="8"
      prefWidth="280"
      styleClass="card">


    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>

    <!-- Image header -->
    <StackPane styleClass="card-image-wrap">
        <ImageView fx:id="imageView" fitWidth="256" fitHeight="140" preserveRatio="false" smooth="true"/>
    </StackPane>

    <Label fx:id="titleLbl" styleClass="card-title"/>
    <Label fx:id="priceLbl" styleClass="card-price"/>
    <Label fx:id="datesLbl" styleClass="card-muted"/>
    <Label fx:id="agencyLbl" styleClass="card-muted"/>

    <HBox spacing="8">
        <Button fx:id="editBtn" text="Edit" onAction="#onEdit"/>
        <Button fx:id="deleteBtn" text="Delete" onAction="#onDelete"/>
        <Button fx:id="addToCartBtn" text="Add to Cart" onAction="#onAddToCart"/>
        <Button text="Details" onAction="#onDetails"/>
    </HBox>



</VBox>
