<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<VBox spacing="25" styleClass="dash-content"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="Controllers.ArchivedOffersGridController">

    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="15">
        <StackPane style="-fx-background-color: #F1F5F9; -fx-background-radius: 10; -fx-padding: 10;">
            <SVGPath content="M20.54 5.23L19.15 3.55C18.88 3.21 18.47 3 18 3H6C5.53 3 5.12 3.21 4.84 3.55L3.46 5.23C3.17 5.57 3 6.01 3 6.5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19V6.5C21 6.01 20.83 5.57 20.54 5.23M6.24 5H17.76L18.59 6H5.41L6.24 5M5 19V8H19V19H5M8 11V13H16V11H8Z"
                     fill="#64748B" scaleX="0.8" scaleY="0.8"/>
        </StackPane>
        <VBox>
            <Label text="Archived Inventory" styleClass="h1" style="-fx-font-size: 22px; -fx-text-fill: #1E293B;"/>
            <Label text="Restore or permanently remove past offers" styleClass="dash-muted"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button onAction="#onRefresh" styleClass="btn-ghost" prefHeight="40" prefWidth="40">
            <graphic>
                <SVGPath content="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                         fill="#64748B" scaleX="0.8" scaleY="0.8"/>
            </graphic>
            <tooltip><Tooltip text="Refresh Offers"/></tooltip>
        </Button>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
        <content>
            <TilePane fx:id="tilePane" prefColumns="3" hgap="20" vgap="25">
                <padding><Insets top="10" right="10" bottom="30" left="10"/></padding>
            </TilePane>
        </content>
    </ScrollPane>
</VBox>