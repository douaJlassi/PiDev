<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="Controllers.ArchivedOfferCardController"
      spacing="12" prefWidth="300"
      style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-color: #E2E8F0; -fx-border-radius: 15; -fx-opacity: 0.85;">

    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <VBox spacing="4">
        <Label fx:id="titleLbl" text="Tunis Adventure"
               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #475569;"/>
        <Label fx:id="datesLbl" text="Jan 12 - Jan 15"
               style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;"/>
    </VBox>

    <HBox alignment="CENTER_LEFT">
        <Label fx:id="priceLbl" text="450 TND"
               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #64748B;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="ARCHIVED" style="-fx-background-color: #F1F5F9; -fx-text-fill: #94A3B8; -fx-padding: 3 8; -fx-background-radius: 5; -fx-font-size: 9px; -fx-font-weight: bold;"/>
    </HBox>

    <Separator opacity="0.2"/>

    <HBox spacing="10">
        <Button text="Restore" onAction="#onRestore" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                style="-fx-background-color: #F0FDF4; -fx-text-fill: #166534; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8;"/>

        <Button text="Delete" onAction="#onDeleteHard" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                style="-fx-background-color: #FEF2F2; -fx-text-fill: #991B1B; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8;"/>
    </HBox>
</VBox>