<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Text?>

<BorderPane fx:id="borderPane" prefHeight="850.0" prefWidth="1300.0" stylesheets="@style.css" styleClass="main-container" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.DashboardGuideController">


    <!-- Sidebar -->
    <left>
        <VBox prefWidth="280.0" spacing="15" styleClass="sidebar">
            <padding>
                <Insets top="40" right="20" bottom="30" left="20" />
            </padding>

            <VBox alignment="CENTER" spacing="10" styleClass="profile-section">
                <Circle fx:id="profileCircle" fill="WHITE" radius="45.0" stroke="#e0e0e0" strokeWidth="1" />
                <VBox alignment="CENTER">
                    <Text fx:id="userNameText" styleClass="user-name" text="Julian Le Guide" />
                    <Label styleClass="user-badge" text="GUIDE CERTIFIÉ" />
                </VBox>
            </VBox>

            <Region prefHeight="30" />

            <VBox spacing="8" VBox.vgrow="ALWAYS">
                <Label styleClass="menu-label" text="MENU PRINCIPAL" />
                <Button maxWidth="1.7976931348623157E308" styleClass="nav-button" text="🏠 Dashboard" />
                <Button maxWidth="1.7976931348623157E308" styleClass="nav-button, nav-button-active" text="📋 Mes Activités" />
                <Button maxWidth="1.7976931348623157E308" styleClass="nav-button" text="📅 Réservations" />
                <Button maxWidth="1.7976931348623157E308" styleClass="nav-button" text="💬 Messagerie" />

                <Label styleClass="menu-label" text="PARAMÈTRES">
                    <VBox.margin><Insets top="20"/></VBox.margin>
                </Label>
                <Button maxWidth="1.7976931348623157E308" styleClass="nav-button" text="⚙️ Configuration" />
            </VBox>

            <Button maxWidth="1.7976931348623157E308" styleClass="logout-button" text="Se déconnecter" />
        </VBox>
    </left>

    <!-- Main Content -->
    <center>
        <VBox spacing="25" styleClass="content-area">
            <padding>
                <Insets top="40" right="40" bottom="40" left="40" />
            </padding>

            <!-- Top Header Area -->
            <HBox alignment="CENTER_LEFT">
                <VBox spacing="5">
                    <Text styleClass="welcome-title" text="Mes Activités" />
                    <Label styleClass="welcome-subtitle" text="Gérez et organisez vos excursions proposées aux voyageurs." />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button styleClass="add-button" text="+ Nouvelle Activité" onAction="#handleNouvelleActivite" />
            </HBox>

            <!-- Filters/Search Bar (Optional but looks professional) -->
            <HBox spacing="15" alignment="CENTER_LEFT" styleClass="search-bar-container">
                <TextField promptText="Rechercher une activité..." styleClass="search-field" HBox.hgrow="ALWAYS" />
                <Button styleClass="filter-button" text="Filtrer" />
            </HBox>

            <!-- Card Container (ListView) -->
            <ListView fx:id="activitiesListView" VBox.vgrow="ALWAYS" styleClass="activity-card-list" />

            <!-- Modern Pagination -->
            <HBox alignment="CENTER" spacing="15" styleClass="pagination-container">


                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="pageInfoLabel" text="Affichage de 1-10 sur 24 activités" styleClass="pagination-info" />
            </HBox>
        </VBox>
    </center>
</BorderPane>