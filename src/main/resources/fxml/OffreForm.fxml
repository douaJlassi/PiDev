<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" xmlns:fx="http://javafx.com/fxml" fx:controller="controllers.OffreFormController">
    <VBox alignment="TOP_CENTER" spacing="20" style="-fx-background-color: -bg;">
        <padding>
            <Insets top="40" right="20" bottom="40" left="20"/>
        </padding>

        <VBox maxWidth="550" spacing="25" styleClass="card">

            <VBox spacing="5">
                <Label fx:id="formTitleLbl" styleClass="h1" text="Create New Offer"/>
                <Label text="Fill in the details below to publish a new promotion." styleClass="muted"/>
            </VBox>

            <Separator opacity="0.5"/>

            <VBox spacing="15">

                <VBox spacing="5">
                    <Label text="Offer Title" styleClass="h2"/>
                    <TextField fx:id="titleTf" promptText="e.g. Summer Escape to Djerba" prefHeight="40"/>
                </VBox>

                <HBox spacing="15">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Original Price (TND)" styleClass="h2"/>
                        <TextField fx:id="originalPriceTf" promptText="300" prefHeight="40"/>
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Discount (%)" styleClass="h2"/>
                        <TextField fx:id="discountTf" promptText="20" prefHeight="40"/>
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Final Price" styleClass="h2"/>
                        <TextField fx:id="priceTf" editable="false" styleClass="price-field" text="0.000" prefHeight="40"
                                   style="-fx-background-color: #f3f4f6; -fx-text-fill: -brand-orange; -fx-font-weight: bold;"/>
                    </VBox>
                </HBox>

                <HBox spacing="15">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Start Date" styleClass="h2"/>
                        <DatePicker fx:id="startDp" maxWidth="Infinity" prefHeight="40"/>
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="End Date" styleClass="h2"/>
                        <DatePicker fx:id="endDp" maxWidth="Infinity" prefHeight="40"/>
                    </VBox>
                </HBox>

                <VBox spacing="5">
                    <Label text="Promotion Image" styleClass="h2"/>
                    <HBox spacing="10">
                        <TextField fx:id="imageTf" editable="false" promptText="No file selected" HBox.hgrow="ALWAYS" prefHeight="40"/>
                        <Button text="Browse" onAction="#onBrowseImage" styleClass="btn-ghost" prefHeight="40"/>
                    </HBox>
                </VBox>

                <VBox spacing="5">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Description" styleClass="form-label" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#onGenerateAIDescription" text="AI Writer ✨"
                                style="-fx-background-color: linear-gradient(to right, #6366F1, #1BB7B1);
                       -fx-text-fill: white; -fx-font-size: 10px; -fx-background-radius: 15;
                       -fx-cursor: hand; -fx-font-weight: bold;" />
                    </HBox>
                    <TextArea fx:id="descTa" prefHeight="100" wrapText="true" />
                </VBox>

                <VBox spacing="5">
                    <Label text="Included Services" styleClass="h2"/>
                    <ListView fx:id="servicesLv" prefHeight="120" styleClass="modern-list-view"/>
                </VBox>
            </VBox>

            <Label fx:id="errorLbl" styleClass="error" wrapText="true"/>

            <HBox spacing="15" alignment="CENTER_RIGHT">
                <Button text="Cancel" onAction="#onCancel" styleClass="btn-ghost" prefWidth="100" prefHeight="40"/>
                <Button text="Save Offer" onAction="#onSave" styleClass="btn-primary" prefWidth="150" prefHeight="40"/>
            </HBox>

        </VBox>
    </VBox>
</ScrollPane>