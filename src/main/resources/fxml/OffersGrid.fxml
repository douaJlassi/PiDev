<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.OffersGridController"
            styleClass="dash-content">

    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <!-- Top bar -->
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button onAction="#onRefresh" styleClass="btn-ghost" prefHeight="40" prefWidth="40">
                <graphic>
                    <SVGPath content="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                             fill="#64748B" scaleX="0.8" scaleY="0.8"/>
                </graphic>
                <tooltip><Tooltip text="Refresh Offers"/></tooltip>
            </Button>

            <!-- ✅ Filters toggle (new) -->
            <!-- New Offer on the left -->
            <Button onAction="#onAdd"
                    text="+ New Offer"
                    style="-fx-background-color: #1BB7B1; -fx-text-fill: white; -fx-padding: 10 18;
               -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;"/>

            <!-- Filters button (white bg + teal text + icon) -->
            <Button fx:id="filtersBtn" onAction="#onToggleFilters"
                    style="-fx-background-color: white; -fx-text-fill: #1BB7B1; -fx-font-weight: bold;
               -fx-padding: 8 14; -fx-background-radius: 20; -fx-border-radius: 20;
               -fx-border-color: rgba(27,183,177,0.35); -fx-cursor: hand;">
                <graphic>
                    <!-- sliders/filter icon -->
                    <SVGPath fill="#1BB7B1"
                             content="M10 18h4v-2h-4v2zm-7-8v2h18v-2H3zm3-6v2h12V4H6zm4 10v2h4v-2h-4z"/>
                </graphic>
                <text>Filters ▾</text>
            </Button>

            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <!-- Cards -->
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color:transparent;">
            <content>
                <TilePane fx:id="tilePane" prefColumns="3" hgap="16" vgap="16">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                </TilePane>
            </content>
        </ScrollPane>
    </center>

    <!-- ✅ Filters panel on the right (new) -->
    <right>
        <StackPane fx:id="filtersHost" prefWidth="300" visible="false" managed="false">
            <fx:include fx:id="filtersInclude" source="OfferFiltersPanel.fxml"/>
        </StackPane>
    </right>

</BorderPane>