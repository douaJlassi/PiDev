<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.control.Tooltip?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.OffersGridController"
      spacing="12">

    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <HBox spacing="10">
        <Button onAction="#onRefresh" styleClass="btn-ghost" prefHeight="40" prefWidth="40">
            <graphic>
                <SVGPath content="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                         fill="#64748B" scaleX="0.8" scaleY="0.8"/>
            </graphic>
            <tooltip><Tooltip text="Refresh Offers"/></tooltip>
        </Button>

        <Button onAction="#onAdd" text="+ New Offer" styleClass="btn-primary"
                style="-fx-background-color: -brand-teal; -fx-padding: 10 25; -fx-font-weight: bold; -fx-background-radius: 10;"/>
    </HBox>

    <ScrollPane fitToWidth="true">
        <content>
            <TilePane fx:id="tilePane"
                      prefColumns="3"
                      hgap="16" vgap="16">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>
            </TilePane>

        </content>
    </ScrollPane>

</VBox>
