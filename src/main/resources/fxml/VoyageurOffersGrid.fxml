<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.VoyageurOffersGridController"
            styleClass="dash-content">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <center>
        <VBox spacing="20">

            <!-- Actualités block (unchanged) -->
            <VBox fx:id="actualitesContainer"
                  spacing="12"
                  prefHeight="250"
                  style="-fx-background-color: white; -fx-padding: 18 20; -fx-background-radius: 15; -fx-border-color: #E7ECF3; -fx-border-radius: 15;">

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <VBox HBox.hgrow="ALWAYS" spacing="2">
                        <Label text="Actualités" styleClass="h1" style="-fx-font-size: 18px;"/>
                        <Label text="Top deals AND new collections you shouldn't miss" styleClass="dash-muted"/>
                    </VBox>
                </HBox>

                <ScrollPane fitToHeight="true"
                            prefHeight="190"
                            minHeight="190"
                            hbarPolicy="AS_NEEDED"
                            vbarPolicy="NEVER"
                            styleClass="scroll-pane"
                            style="-fx-background-color: transparent;">
                    <content>
                        <HBox fx:id="actualitiesBox" spacing="16" style="-fx-background-color: transparent;">
                            <padding>
                                <Insets top="8" right="8" bottom="8" left="8"/>
                            </padding>
                        </HBox>
                    </content>
                </ScrollPane>
            </VBox>

            <!-- Header bar -->
            <HBox alignment="CENTER_LEFT" spacing="20"
                  style="-fx-background-color: white; -fx-padding: 15 25; -fx-background-radius: 15; -fx-border-color: #E7ECF3; -fx-border-radius: 15;">

                <VBox HBox.hgrow="ALWAYS">
                    <Label text="Discover Your Next Adventure" styleClass="h1" style="-fx-font-size: 22px;"/>
                    <Label text="Explore the best travel deals across The World" styleClass="dash-muted"/>
                </VBox>

                <HBox spacing="10" alignment="CENTER_RIGHT">

                    <!-- Filters button (styled like agency) -->
                    <Button fx:id="filtersBtn" onAction="#onToggleFilters"
                            style="-fx-background-color: white; -fx-text-fill: #1BB7B1; -fx-font-weight: bold;
                                   -fx-padding: 8 14; -fx-background-radius: 20; -fx-border-radius: 20;
                                   -fx-border-color: rgba(27,183,177,0.35); -fx-cursor: hand;">
                        <graphic>
                            <SVGPath fill="#1BB7B1"
                                     content="M10 18h4v-2h-4v2zm-7-8v2h18v-2H3zm3-6v2h12V4H6zm4 10v2h4v-2h-4z"/>
                        </graphic>
                        <text>Filters ▾</text>
                    </Button>

                    <Button onAction="#onRefresh" styleClass="btn-ghost" prefHeight="40" prefWidth="40">
                        <graphic>
                            <SVGPath content="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                     fill="#64748B" scaleX="0.8" scaleY="0.8"/>
                        </graphic>
                        <tooltip><Tooltip text="Refresh Offers"/></tooltip>
                    </Button>

                    <Button text="View My Cart" onAction="#onMyCart"
                            style="-fx-background-color: #1BB7B1; -fx-text-fill: white; -fx-font-weight: bold;
                                   -fx-padding: 0 20; -fx-background-radius: 10; -fx-cursor: hand;"
                            prefHeight="40">
                        <graphic>
                            <SVGPath content="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.44C4.83 14.33 5 15 5 15c0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63.14-1.12h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"
                                     fill="white" scaleX="0.7" scaleY="0.7"/>
                        </graphic>
                    </Button>

                </HBox>
            </HBox>

            <!-- Offers list -->
            <ScrollPane fx:id="offersScroll" fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane">
                <content>
                    <TilePane fx:id="tilePane"
                              prefColumns="3"
                              hgap="20"
                              vgap="25"
                              style="-fx-background-color: transparent;">
                        <padding>
                            <Insets top="10" right="10" bottom="30" left="10"/>
                        </padding>
                    </TilePane>
                </content>
            </ScrollPane>

        </VBox>
    </center>

    <!-- Filters panel -->
    <right>
        <StackPane fx:id="filtersHost" prefWidth="300" visible="false" managed="false"/>
    </right>

</BorderPane>