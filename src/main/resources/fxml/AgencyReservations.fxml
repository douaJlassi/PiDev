<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.shape.SVGPath?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.AgencyReservationsController"
      spacing="15" styleClass="dash-content">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox HBox.hgrow="ALWAYS">
            <Label text="Booking Requests" styleClass="h1" style="-fx-font-size: 22px;"/>
            <Label text="Confirm availability for your offers" styleClass="dash-muted"/>
        </VBox>

        <Button onAction="#onRefresh" styleClass="btn-ghost" prefHeight="40" prefWidth="40">
            <graphic>
                <SVGPath content="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                         fill="#64748B" scaleX="0.8" scaleY="0.8"/>
            </graphic>
            <tooltip><Tooltip text="Refresh Offers"/></tooltip>
        </Button>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colResId" text="Reservation" prefWidth="120"/>
            <TableColumn fx:id="colClient" text="Client" prefWidth="90"/>
            <TableColumn fx:id="colOffer" text="Offer" prefWidth="260"/>
            <TableColumn fx:id="colPrice" text="Price" prefWidth="120"/>
            <TableColumn fx:id="colResStatus" text="Reservation" prefWidth="130"/>
            <TableColumn fx:id="colAgencyStatus" text="Availability" prefWidth="130"/>
            <TableColumn fx:id="colEnds" text="Decision At" prefWidth="170"/>
            <TableColumn fx:id="colActions" text="Actions" prefWidth="240"/>
        </columns>
    </TableView>

</VBox>