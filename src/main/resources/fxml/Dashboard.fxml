<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/17"
            fx:controller="controllers.DashboardController"
            styleClass="dash-root">

    <left>
        <VBox styleClass="dash-sidebar" spacing="10" prefWidth="250">
            <padding>
                <Insets top="0" right="0" bottom="20" left="0"/>
            </padding>

            <VBox alignment="CENTER" prefHeight="160" spacing="0">
                <StackPane style="-fx-padding: 30 20 20 20;">
                    <ImageView fx:id="logoImg"
                               fitWidth="180.0"
                               preserveRatio="true"
                               smooth="true"
                               cache="true"/>
                </StackPane>
                <Separator maxWidth="200" opacity="0.15">
                    <VBox.margin>
                        <Insets top="10"/>
                    </VBox.margin>
                </Separator>
            </VBox>

            <VBox spacing="6" VBox.vgrow="ALWAYS">
                <padding><Insets left="15" right="15"/></padding>

                <Label text="MAIN MENU" styleClass="dash-muted"
                       style="-fx-font-size: 10px; -fx-font-weight: 800; -fx-padding: 10 0 5 12; -fx-text-fill: #94A3B8;"/>

                <Button fx:id="offersBtn" text="Explore Offers" onAction="#onGoOffers" styleClass="dash-nav-btn" maxWidth="Infinity">
                    <graphic>
                        <SVGPath content="M12 2L4.5 20.29L5.21 21L12 18L18.79 21L19.5 20.29L12 2Z" fill="#1BB7B1"/>
                    </graphic>
                </Button>

                <Button fx:id="cartBtn" text="My Cart" onAction="#onGoCart" styleClass="dash-nav-btn" maxWidth="Infinity">
                    <graphic>
                        <SVGPath content="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.44C4.83 14.33 5 15 5 15c0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63.14-1.12h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99 2 1.99 2s2-.9 2-2-.9-2-2-2z" fill="#1BB7B1"/>
                    </graphic>
                </Button>

                <Button fx:id="reservationsBtn" text="Reservations" onAction="#onGoReservations" styleClass="dash-nav-btn" maxWidth="Infinity">
                    <graphic>
                        <SVGPath content="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11z" fill="#1BB7B1"/>
                    </graphic>
                </Button>

                <Button fx:id="archiveBtn" text="Archive" onAction="#onGoArchive" styleClass="dash-nav-btn" maxWidth="Infinity">
                    <graphic>
                        <SVGPath content="M20.54 5.23L19.15 3.55C18.88 3.21 18.47 3 18 3H6C5.53 3 5.12 3.21 4.84 3.55L3.46 5.23C3.17 5.57 3 6.01 3 6.5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19V6.5C21 6.01 20.83 5.57 20.54 5.23M6.24 5H17.76L18.59 6H5.41L6.24 5M5 19V8H19V19H5M8 11V13H16V11H8z" fill="#1BB7B1"/>
                    </graphic>
                </Button>
            </VBox>

            <VBox spacing="10" style="-fx-background-color: #F8FAFC; -fx-padding: 15; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-width: 1;">
                <VBox.margin><Insets left="15" right="15"/></VBox.margin>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <StackPane style="-fx-background-color: #1BB7B1; -fx-background-radius: 8; -fx-min-width: 32; -fx-min-height: 32;">
                        <Label fx:id="initialsLbl" text="A" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                    </StackPane>
                    <VBox HBox.hgrow="ALWAYS">
                        <Label fx:id="roleLbl" text="TRAVELER" style="-fx-font-size: 9px; -fx-font-weight: 900; -fx-text-fill: #1BB7B1;"/>
                        <Label fx:id="userLblSide" text="User" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                    </VBox>
                </HBox>
            </VBox>
        </VBox>
    </left>

    <top>
        <HBox styleClass="dash-topbar" spacing="20" alignment="CENTER_LEFT">
            <padding>
                <Insets top="15" right="25" bottom="15" left="25"/>
            </padding>

            <HBox alignment="CENTER_LEFT" styleClass="dash-search" prefWidth="400" spacing="10">
                <SVGPath content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" fill="#64748B" />
                <TextField fx:id="searchTf" promptText="Where do you want to go?" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0;" HBox.hgrow="ALWAYS"/>
            </HBox>

            <Button fx:id="filtersBtn" text="Filters ▾" onAction="#onToggleRightPanel" styleClass="btn-ghost" style="-fx-border-radius: 20; -fx-background-radius: 20;"/>

            <HBox HBox.hgrow="ALWAYS"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label fx:id="userLbl" text="Ahmed Ben Jemaa" styleClass="dash-user" />
                <StackPane style="-fx-background-color: -brand-teal; -fx-background-radius: 50; -fx-min-width: 35; -fx-min-height: 35;">
                    <Label text="A" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                </StackPane>
            </HBox>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="contentHost" styleClass="dash-content" />
    </center>

    <right>
        <VBox fx:id="rightPanel" spacing="20" styleClass="rightbar" prefWidth="300">
            <padding><Insets top="30" right="25" bottom="25" left="25"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Filter Results" styleClass="h1" style="-fx-font-size: 20px;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button onAction="#onToggleRightPanel" text="✕" styleClass="btn-ghost" style="-fx-text-fill: #94A3B8;"/>
            </HBox>

            <VBox spacing="10">
                <Label text="TRAVEL DATE" styleClass="dash-muted" style="-fx-font-weight: bold; -fx-font-size: 10px;"/>
                <DatePicker fx:id="calendarDp" maxWidth="Infinity" promptText="Select date"
                            style="-fx-background-radius: 10; -fx-border-radius: 10;"/>
            </VBox>

            <VBox spacing="10">
                <Label text="BUDGET RANGE (TND)" styleClass="dash-muted" style="-fx-font-weight: bold; -fx-font-size: 10px;"/>
                <HBox spacing="12">
                    <TextField fx:id="minPriceTf" promptText="Min" HBox.hgrow="ALWAYS"
                               style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 8;"/>
                    <TextField fx:id="maxPriceTf" promptText="Max" HBox.hgrow="ALWAYS"
                               style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 8;"/>
                </HBox>
            </VBox>

            <VBox spacing="10" VBox.vgrow="ALWAYS">
                <Label text="PARTNER AGENCIES" styleClass="dash-muted" style="-fx-font-weight: bold; -fx-font-size: 10px;"/>
                <ListView fx:id="agenciesLv" VBox.vgrow="ALWAYS" styleClass="modern-list-view"
                          style="-fx-background-radius: 10; -fx-border-radius: 10;"/>
            </VBox>

            <Button text="Reset All Filters" onAction="#onClearFilters" maxWidth="Infinity" prefHeight="45"
                    style="-fx-background-color: #F1F5F9; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-background-radius: 10;"/>
        </VBox>
    </right>

</BorderPane>

