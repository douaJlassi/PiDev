<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox styleClass="modern-achats-root" spacing="0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.MesAchatsController">

    <!-- Header with title and back button -->
    <HBox styleClass="modern-header" alignment="CENTER_LEFT" spacing="15">
        <padding>
            <Insets top="20" right="25" bottom="20" left="25" />
        </padding>
        <Button fx:id="backButton" text="←" styleClass="modern-back-btn" />
        <Label styleClass="modern-title" text="📋 Mes Réservations" />
    </HBox>

    <!-- Main content -->
    <VBox spacing="20" VBox.vgrow="ALWAYS" styleClass="modern-content">
        <padding>
            <Insets top="15" right="25" bottom="25" left="25" />
        </padding>

        <!-- Search bar and filter -->
        <HBox spacing="15" alignment="CENTER_LEFT">
            <TextField promptText="Rechercher une réservation..." styleClass="modern-search-field" HBox.hgrow="ALWAYS" />
            <Button text="Filtrer" styleClass="modern-filter-btn" />
        </HBox>

        <!-- Stats / summary -->
        <HBox spacing="20" styleClass="modern-stats">
            <Label styleClass="stat-label" text="Total des réservations: 12" />
            <Label styleClass="stat-label" text="Montant total: 1 240 DT" />
        </HBox>

        <!-- List of reservations -->
        <ListView fx:id="achatsListView" VBox.vgrow="ALWAYS" styleClass="modern-list" />
    </VBox>
</VBox>