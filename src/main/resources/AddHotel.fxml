<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600" prefWidth="900" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="projet.controllers.addHotel">

    <!-- Carte centrale -->
    <VBox layoutX="250.0" layoutY="27.0" spacing="12" styleClass="card">

        <Label styleClass="title" text="Ajouter un Hôtel" />


        <TextField fx:id="tfNom" promptText="Nom" />
        <TextField fx:id="tfDescription" promptText="Description" />
        <TextField fx:id="tfPrix" promptText="Prix" />
        <TextField fx:id="tfCapacite" promptText="Capacité" />
        <TextField fx:id="tfNbEtoiles" promptText="Nombre d'étoiles" />
        <TextField fx:id="tfLocalisation" promptText="Localisation" />
        <TextField fx:id="tfChambre" promptText="Type de chambre" />

        <CheckBox fx:id="cbDisponibilite" styleClass="checkbox" text="Disponible" />

        <Button onAction="#addHotel" styleClass="btn" text="Ajouter Hôtel" />

    </VBox>

</AnchorPane>
