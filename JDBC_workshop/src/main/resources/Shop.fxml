<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.esprit.projet.controlles.ShopController"
            prefWidth="1200"
            prefHeight="800"
            style="-fx-background-color: #f8faff;">

    <top>
        <VBox spacing="0">
            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="20"
                  style="-fx-background-color: linear-gradient(to right, #0FA5A2, #1D4D7C); -fx-padding: 20 30;">
                <Label text="🛒 Rehletna Shop" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="backBtn" text="← Back to Main"
                        style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 25; -fx-cursor: hand;"/>
            </HBox>

            <!-- User Info Bar -->
            <HBox spacing="30" style="-fx-background-color: white; -fx-padding: 15 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 0);"
                  alignment="CENTER_LEFT">
                <Label fx:id="welcomeLabel" text="Welcome!" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1D4D7C;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Circle radius="12" fill="#FEC74C"/>
                    <Label text="Your Coins:" style="-fx-font-size: 14px; -fx-text-fill: #666;"/>
                    <Label fx:id="coinsLabel" text="0 🪙" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #FEC74C;"/>
                </HBox>
            </HBox>

            <!-- Search and Filter Bar -->
            <HBox spacing="15" style="-fx-background-color: white; -fx-padding: 15 30; -fx-border-color: #f0f0f0; -fx-border-width: 1 0 0 0;">
                <Label text="Filter:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #666;"/>
                <ComboBox fx:id="categoryFilter" prefWidth="150"/>
                <TextField fx:id="searchField" promptText="Search products..." HBox.hgrow="ALWAYS"
                           style="-fx-padding: 8; -fx-background-radius: 8; -fx-border-color: #ddd; -fx-border-radius: 8;"/>
                <Button fx:id="searchBtn" text="🔍 Search"
                        style="-fx-background-color: #0FA5A2; -fx-text-fill: white; -fx-padding: 8 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
                <Button fx:id="refreshBtn" text="🔄 Refresh"
                        style="-fx-background-color: #FEC74C; -fx-text-fill: #333; -fx-padding: 8 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;">
            <VBox spacing="20" style="-fx-padding: 30;">
                <Label text="✨ Available Products" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1D4D7C;"/>
                <GridPane fx:id="productsGrid" hgap="20" vgap="20" alignment="CENTER">
                    <padding>
                        <Insets bottom="20" right="20"/>
                    </padding>
                </GridPane>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: #f0f0f0; -fx-padding: 15;">
            <Label text="© 2025 Rehletna.tn - Spend your coins wisely!" style="-fx-font-size: 12px; -fx-text-fill: #999;"/>
        </HBox>
    </bottom>
</BorderPane>