<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.AgencyDashboardController"
            stylesheets="@../styles/dashboard.css"
            styleClass="dashboard-root">

    <!-- ===== TOP BAR ===== -->
    <top>
        <HBox styleClass="nav-bar" alignment="CENTER_LEFT" spacing="16">
            <padding><Insets top="12" right="24" bottom="12" left="24"/></padding>
            <Label text="Agency Back Office" styleClass="agency-title-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="agencyNameLabel" styleClass="agency-name-label" text="My Agency"/>
            <Button text="⟳" styleClass="icon-btn" onAction="#onRefresh"/>
            <Button fx:id="themeToggleBtn" text="Dark Mode" styleClass="theme-toggle-btn" onAction="#toggleTheme"/>
        </HBox>
    </top>

    <!-- ===== MAIN SPLIT ===== -->
    <center>
        <HBox>

            <!-- LEFT: filter tabs -->
            <VBox styleClass="agency-sidebar" spacing="0" minWidth="180" maxWidth="180">
                <padding><Insets top="20" right="0" bottom="20" left="0"/></padding>

                <fx:define>
                    <ToggleGroup fx:id="filterGroup"/>
                </fx:define>

                <Label text="Filter" styleClass="agency-filter-title"/>

                <ToggleButton fx:id="pendingTab" text="Pending" toggleGroup="$filterGroup"
                              selected="true" onAction="#onFilterChanged" maxWidth="Infinity" styleClass="agency-filter-btn"/>

                <ToggleButton fx:id="approvedTab" text="Approved" toggleGroup="$filterGroup"
                              onAction="#onFilterChanged" maxWidth="Infinity" styleClass="agency-filter-btn"/>

            </VBox>


            <!-- RIGHT: submission list -->
            <VBox HBox.hgrow="ALWAYS">
                <ScrollPane fitToWidth="true" styleClass="posts-scroll-pane" VBox.vgrow="ALWAYS">
                    <VBox fx:id="submissionList" spacing="16" styleClass="agency-list">
                        <padding><Insets top="24" right="32" bottom="24" left="24"/></padding>
                    </VBox>
                </ScrollPane>
            </VBox>

        </HBox>
    </center>

</BorderPane>
