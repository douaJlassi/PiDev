<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            styleClass="map-view-root">

    <!-- ═══ HEADER ═══ -->
    <top>
        <HBox styleClass="map-header" alignment="CENTER_LEFT" spacing="12">
            <padding><Insets top="12" right="20" bottom="12" left="20"/></padding>

            <Button styleClass="close-detail-btn" text="✕" onAction="#onClose"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="🗺  Explore Map" styleClass="map-header-title"/>
            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="statusLabel" styleClass="map-status-label"
                   visible="false" managed="false" text=""/>

            <HBox spacing="4" alignment="CENTER">
                <Button text="+" styleClass="map-zoom-btn" onAction="#onZoomIn"/>
                <Button text="−" styleClass="map-zoom-btn" onAction="#onZoomOut"/>
            </HBox>
        </HBox>
    </top>

    <!-- ═══ MAP AREA (pure JavaFX — no WebView) ═══ -->
    <center>
        <StackPane>
            <StackPane fx:id="mapContainer" styleClass="map-canvas-container"
                       alignment="TOP_LEFT"/>
            <VBox alignment="BOTTOM_CENTER" mouseTransparent="true">
                <padding><Insets bottom="20"/></padding>
                <Label fx:id="pinCountLabel" styleClass="map-pin-count"
                       visible="false" managed="false" text=""/>
            </VBox>
        </StackPane>
    </center>

</BorderPane>
