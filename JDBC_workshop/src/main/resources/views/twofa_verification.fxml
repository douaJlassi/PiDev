<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="controllers.TwoFAVerificationController"
           prefWidth="1000" prefHeight="787">

    <!-- Background -->
    <ImageView fitWidth="1000" fitHeight="787" preserveRatio="false">
        <image>
            <Image url="@../image/image11.jpg"/>
        </image>
    </ImageView>

    <Rectangle width="1000" height="787"
               fill="linear-gradient(to bottom right, rgba(25,40,75,0.45), rgba(45,35,65,0.55))"/>

    <!-- MAIN -->
    <VBox alignment="CENTER" spacing="30" maxWidth="550"
          style="-fx-background-color: rgba(255,255,255,0.15);
                 -fx-background-radius: 30;
                 -fx-border-color: rgba(255,255,255,0.25);
                 -fx-border-radius: 30;
                 -fx-padding: 40;">

        <!-- Logo -->
        <HBox spacing="0" alignment="CENTER">
            <Label text="Reh" style="-fx-text-fill:#0FA5A2;-fx-font-size:48px;-fx-font-weight:800;"/>
            <Label text="let" style="-fx-text-fill:#FEC74C;-fx-font-size:48px;-fx-font-weight:800;"/>
            <Label text="na.tn" style="-fx-text-fill:#1D4D7C;-fx-font-size:48px;-fx-font-weight:800;"/>
        </HBox>

        <!-- Title -->
        <Label text="Two-Factor Authentication"
               style="-fx-text-fill:white;-fx-font-size:28px;-fx-font-weight:bold;"/>

        <!-- Email Icon and Message -->
        <VBox spacing="10" alignment="CENTER">
            <Label text="📧" style="-fx-font-size: 60px;"/>
            <Label fx:id="emailDisplayLabel" text="Verification code sent to:"
                   style="-fx-text-fill:white;-fx-font-size:16px;-fx-font-weight:bold;"/>
            <Label fx:id="userEmailLabel" text="user@example.com"
                   style="-fx-text-fill:#FEC74C;-fx-font-size:18px;-fx-font-weight:bold;"/>
        </VBox>

        <!-- Instruction -->
        <Label text="Please enter the 6-digit code sent to your email"
               style="-fx-text-fill:rgba(255,255,255,0.9);-fx-font-size:14px;"/>

        <!-- 6-Digit Code Boxes -->
        <HBox fx:id="codeBox" spacing="12" alignment="CENTER">
            <TextField fx:id="code1" prefWidth="70" prefHeight="80"
                       style="-fx-background-color: rgba(255,255,255,0.20);
                              -fx-background-radius: 15;
                              -fx-border-radius: 15;
                              -fx-border-color: rgba(255,255,255,0.35);
                              -fx-border-width: 2;
                              -fx-text-fill: white;
                              -fx-font-size: 32px;
                              -fx-font-weight: bold;
                              -fx-alignment: center;
                              -fx-padding: 5;"/>

            <TextField fx:id="code2" prefWidth="70" prefHeight="80"
                       style="-fx-background-color: rgba(255,255,255,0.20);
                              -fx-background-radius: 15;
                              -fx-border-radius: 15;
                              -fx-border-color: rgba(255,255,255,0.35);
                              -fx-border-width: 2;
                              -fx-text-fill: white;
                              -fx-font-size: 32px;
                              -fx-font-weight: bold;
                              -fx-alignment: center;
                              -fx-padding: 5;"/>

            <TextField fx:id="code3" prefWidth="70" prefHeight="80"
                       style="-fx-background-color: rgba(255,255,255,0.20);
                              -fx-background-radius: 15;
                              -fx-border-radius: 15;
                              -fx-border-color: rgba(255,255,255,0.35);
                              -fx-border-width: 2;
                              -fx-text-fill: white;
                              -fx-font-size: 32px;
                              -fx-font-weight: bold;
                              -fx-alignment: center;
                              -fx-padding: 5;"/>

            <TextField fx:id="code4" prefWidth="70" prefHeight="80"
                       style="-fx-background-color: rgba(255,255,255,0.20);
                              -fx-background-radius: 15;
                              -fx-border-radius: 15;
                              -fx-border-color: rgba(255,255,255,0.35);
                              -fx-border-width: 2;
                              -fx-text-fill: white;
                              -fx-font-size: 32px;
                              -fx-font-weight: bold;
                              -fx-alignment: center;
                              -fx-padding: 5;"/>

            <TextField fx:id="code5" prefWidth="70" prefHeight="80"
                       style="-fx-background-color: rgba(255,255,255,0.20);
                              -fx-background-radius: 15;
                              -fx-border-radius: 15;
                              -fx-border-color: rgba(255,255,255,0.35);
                              -fx-border-width: 2;
                              -fx-text-fill: white;
                              -fx-font-size: 32px;
                              -fx-font-weight: bold;
                              -fx-alignment: center;
                              -fx-padding: 5;"/>

            <TextField fx:id="code6" prefWidth="70" prefHeight="80"
                       style="-fx-background-color: rgba(255,255,255,0.20);
                              -fx-background-radius: 15;
                              -fx-border-radius: 15;
                              -fx-border-color: rgba(255,255,255,0.35);
                              -fx-border-width: 2;
                              -fx-text-fill: white;
                              -fx-font-size: 32px;
                              -fx-font-weight: bold;
                              -fx-alignment: center;
                              -fx-padding: 5;"/>
        </HBox>

        <!-- Error Label -->
        <Label fx:id="errorLabel" text="" textFill="#ff5e62" style="-fx-font-size: 14px;" visible="false"/>

        <!-- Timer Label -->
        <Label fx:id="timerLabel" text="Code expires in: 05:00"
               style="-fx-text-fill:#FEC74C;-fx-font-size: 14px;-fx-font-weight: bold;"/>

        <!-- Buttons -->
        <HBox spacing="15" alignment="CENTER">
            <Button text="Verify" onAction="#handleVerify"
                    style="-fx-background-color: linear-gradient(to right,#36d1dc,#5b86e5);
                           -fx-text-fill:white;
                           -fx-font-weight:bold;
                           -fx-font-size: 16px;
                           -fx-background-radius: 24;
                           -fx-padding: 12 30;
                           -fx-cursor: hand;"/>

            <Button text="Resend Code" onAction="#handleResendCode"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: white;
                           -fx-font-size: 14px;
                           -fx-underline: true;
                           -fx-cursor: hand;"/>
        </HBox>

        <!-- Back to Login Link -->
        <Button text="← Back to Login" onAction="#handleBackToLogin"
                style="-fx-background-color: transparent;
                       -fx-text-fill: white;
                       -fx-font-size: 14px;
                       -fx-underline: true;
                       -fx-cursor: hand;"
                alignment="CENTER"/>
    </VBox>
</StackPane>