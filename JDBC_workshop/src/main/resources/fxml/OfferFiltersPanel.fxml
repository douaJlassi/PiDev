<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.OfferFiltersPanelController"
      spacing="20"
      prefWidth="300"
      style="-fx-background-color:white;
             -fx-border-color:#E2E8F0;
             -fx-border-width:0 0 0 1;
             -fx-font-family:'Segoe UI';">

    <padding>
        <Insets top="25" right="22" bottom="22" left="22"/>
    </padding>

    <!-- HEADER -->

    <HBox alignment="CENTER_LEFT" spacing="10">

        <Label text="Filter Results"
               style="-fx-font-size:18px;
                      -fx-font-weight:800;
                      -fx-text-fill:#0F172A;" />

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="✕"
                onAction="#onClose"
                style="-fx-background-color:transparent;
                       -fx-border-color:#E5E7EB;
                       -fx-border-radius:10;
                       -fx-text-fill:#94A3B8;
                       -fx-cursor:hand;" />

    </HBox>


    <!-- AI ASSISTANT BOX -->

    <VBox fx:id="aiAgentBox"
          spacing="12"
          style="-fx-background-color:#F0FDFA;
                 -fx-padding:15;
                 -fx-background-radius:12;
                 -fx-border-color:#1BB7B1;
                 -fx-border-width:1;">

        <HBox alignment="CENTER_LEFT" spacing="8">

            <SVGPath content="M12 2L4.5 20.29L5.21 21L12 18L18.79 21L19.5 20.29L12 2Z"
                     fill="#1BB7B1"
                     scaleX="0.6"
                     scaleY="0.6"/>

            <Label text="AI SMART ASSISTANT"
                   style="-fx-font-weight:900;
                          -fx-font-size:10px;
                          -fx-text-fill:#1BB7B1;" />

        </HBox>


        <TextArea fx:id="aiSearchArea"
                  promptText="Try: 'A 5-star trip to Paris under 5000 TND...'"
                  prefHeight="85"
                  wrapText="true"
                  style="-fx-background-color:white;
                         -fx-background-radius:8;
                         -fx-border-radius:8;
                         -fx-border-color:#E2E8F0;
                         -fx-font-size:12px;" />


        <Button fx:id="aiSearchBtn"
                text="Search with IA Agent"
                onAction="#onAISmartSearch"
                maxWidth="Infinity"
                prefHeight="35"
                style="-fx-background-color:#1BB7B1;
                       -fx-text-fill:white;
                       -fx-font-weight:bold;
                       -fx-background-radius:8;
                       -fx-cursor:hand;" />

    </VBox>


    <Separator opacity="0.12"/>


    <!-- DATE FILTER -->

    <VBox spacing="10">

        <Label text="TRAVEL DATE"
               style="-fx-text-fill:#6B7280;
                      -fx-font-weight:bold;
                      -fx-font-size:10px;" />

        <DatePicker fx:id="calendarDp"
                    maxWidth="Infinity"
                    promptText="Select date"
                    style="-fx-background-radius:10;
                           -fx-border-radius:10;" />

    </VBox>


    <!-- PRICE FILTER -->

    <VBox spacing="10">

        <Label text="BUDGET RANGE (TND)"
               style="-fx-text-fill:#6B7280;
                      -fx-font-weight:bold;
                      -fx-font-size:10px;" />

        <HBox spacing="12">

            <TextField fx:id="minPriceTf"
                       promptText="Min"
                       HBox.hgrow="ALWAYS"
                       style="-fx-background-color:#F8FAFC;
                              -fx-border-color:#E2E8F0;
                              -fx-background-radius:8;
                              -fx-border-radius:8;
                              -fx-padding:8;" />

            <TextField fx:id="maxPriceTf"
                       promptText="Max"
                       HBox.hgrow="ALWAYS"
                       style="-fx-background-color:#F8FAFC;
                              -fx-border-color:#E2E8F0;
                              -fx-background-radius:8;
                              -fx-border-radius:8;
                              -fx-padding:8;" />

        </HBox>

    </VBox>


    <!-- AGENCIES LIST -->

    <VBox spacing="10" VBox.vgrow="ALWAYS">

        <Label fx:id="agenciesLbl"
               text="PARTNER AGENCIES"
               style="-fx-text-fill:#6B7280;
                      -fx-font-weight:bold;
                      -fx-font-size:10px;" />

        <ListView fx:id="agenciesLv"
                  VBox.vgrow="ALWAYS"
                  style="-fx-background-radius:10;
                         -fx-border-radius:10;
                         -fx-border-color:#E5E7EB;" />

    </VBox>


    <!-- RESET BUTTON -->

    <Button text="Reset All Filters"
            onAction="#onClearFilters"
            maxWidth="Infinity"
            prefHeight="45"
            style="-fx-background-color:#F1F5F9;
                   -fx-text-fill:#475569;
                   -fx-font-weight:bold;
                   -fx-background-radius:10;" />

</VBox>