<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<VBox spacing="20"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.MyReservationsController"
      style="-fx-background-color:#F6F8FB; -fx-font-family:'Segoe UI';">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <!-- HEADER CARD -->

    <VBox spacing="15"
          style="-fx-background-color:white;
                 -fx-padding:20;
                 -fx-background-radius:15;
                 -fx-border-color:#E7ECF3;
                 -fx-border-radius:15;">

        <HBox alignment="CENTER_LEFT" spacing="20">

            <!-- BACK BUTTON -->

            <StackPane style="-fx-background-color:rgba(27,183,177,0.1);
                              -fx-background-radius:10;
                              -fx-padding:8;">

                <Button text="←"
                        onAction="#onBack"
                        style="-fx-background-color:transparent;
                               -fx-border-color:#E5E7EB;
                               -fx-border-radius:10;
                               -fx-text-fill:#0F172A;
                               -fx-font-size:16px;
                               -fx-cursor:hand;"/>

            </StackPane>


            <!-- TITLE -->

            <VBox HBox.hgrow="ALWAYS">

                <Label text="My Reservations"
                       style="-fx-font-size:22px;
                              -fx-font-weight:800;
                              -fx-text-fill:#0F172A;" />

                <Label text="Manage your upcoming adventures"
                       style="-fx-text-fill:#6B7280;" />

            </VBox>


            <!-- REFRESH BUTTON -->

            <Button onAction="#onRefresh"
                    prefHeight="40"
                    prefWidth="40"
                    style="-fx-background-color:transparent;
                           -fx-border-color:#E5E7EB;
                           -fx-border-radius:10;
                           -fx-cursor:hand;">

                <graphic>
                    <SVGPath content="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                             fill="#64748B"
                             scaleX="0.8"
                             scaleY="0.8"/>
                </graphic>

                <tooltip>
                    <Tooltip text="Refresh Offers"/>
                </tooltip>

            </Button>

        </HBox>


        <Separator opacity="0.4"/>


        <!-- SEARCH AREA -->

        <HBox spacing="15" alignment="CENTER_LEFT">

            <TextField fx:id="searchField"
                       promptText="Search by date or status..."
                       HBox.hgrow="ALWAYS"
                       style="-fx-background-radius:12;
                              -fx-border-radius:12;
                              -fx-border-color:#1BB7B1;
                              -fx-background-color:white;
                              -fx-padding:8;" />

            <ComboBox fx:id="statusFilter"
                      promptText="Filter Status"
                      prefWidth="150"
                      style="-fx-background-radius:12;
                             -fx-background-color:#F2F5FA;" />

        </HBox>

    </VBox>


    <!-- TABLE -->

    <TableView fx:id="table"
               VBox.vgrow="ALWAYS"
               style="-fx-background-color:white;
                      -fx-background-radius:14;
                      -fx-border-radius:14;
                      -fx-border-color:rgba(0,0,0,0.08);">

        <columns>

            <TableColumn fx:id="dateCol"
                         text="RESERVATION DATE"
                         prefWidth="180" />

            <TableColumn fx:id="statusCol"
                         text="STATUS"
                         prefWidth="140" />

            <TableColumn fx:id="payCol"
                         text="METHOD"
                         prefWidth="140" />

            <TableColumn fx:id="totalCol"
                         text="TOTAL AMOUNT"
                         prefWidth="140" />

            <TableColumn fx:id="actionCol"
                         text="DETAILS"
                         prefWidth="100" />

        </columns>

    </TableView>


    <!-- FOOTER -->

    <HBox alignment="CENTER_RIGHT">

        <Label fx:id="msgLbl"
               text="Showing all reservations"
               style="-fx-text-fill:#6B7280;" />

    </HBox>

</VBox>