<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox spacing="20" xmlns:fx="http://javafx.com/fxml">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Header with Search and Add Button -->
    <HBox spacing="20" alignment="CENTER_LEFT">
        <Label text="User Management" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1D4D7C;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="searchField" promptText="Search users..." prefWidth="250" style="-fx-padding: 10; -fx-background-radius: 10;">
            <HBox.margin>
                <Insets right="10"/>
            </HBox.margin>
        </TextField>
        <Button fx:id="addUserBtn" text="+ Add User" style="-fx-background-color: #0FA5A2; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 10; -fx-cursor: hand;"/>
    </HBox>

    <!-- Users Table -->
    <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 0);">

        <!-- Table Header -->
        <GridPane hgap="10" vgap="10" style="-fx-padding: 10 0; -fx-border-color: #f0f0f0; -fx-border-width: 0 0 1 0;">
            <columnConstraints>
                <ColumnConstraints percentWidth="10"/>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="20"/>
                <ColumnConstraints percentWidth="20"/>
            </columnConstraints>

            <Label text="ID" style="-fx-font-weight: bold; -fx-text-fill: #666;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <Label text="Username" style="-fx-font-weight: bold; -fx-text-fill: #666;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Label text="Email" style="-fx-font-weight: bold; -fx-text-fill: #666;" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <Label text="Role" style="-fx-font-weight: bold; -fx-text-fill: #666;" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
            <Label text="Actions" style="-fx-font-weight: bold; -fx-text-fill: #666;" GridPane.columnIndex="4" GridPane.rowIndex="0"/>
        </GridPane>

        <!-- Table Content -->
        <VBox fx:id="usersContainer" spacing="5">
            <!-- Dynamic content will be added here -->
        </VBox>

        <!-- Pagination -->
        <HBox spacing="10" alignment="CENTER" style="-fx-padding: 20 0 0 0;">
            <Button text="Previous" style="-fx-background-color: #f0f0f0; -fx-padding: 8 15; -fx-background-radius: 8; -fx-cursor: hand;"/>
            <Label text="Page 1 of 1" style="-fx-padding: 0 10;"/>
            <Button text="Next" style="-fx-background-color: #f0f0f0; -fx-padding: 8 15; -fx-background-radius: 8; -fx-cursor: hand;"/>
        </HBox>
    </VBox>
</VBox>