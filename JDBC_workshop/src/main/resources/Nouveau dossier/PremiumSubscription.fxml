<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.PremiumSubscriptionController"
            prefWidth="1200"
            prefHeight="700"
            style="-fx-background-color: #f8faff;">

    <top>
        <VBox spacing="0">
            <!-- Header with gradient -->
            <HBox alignment="CENTER_LEFT" spacing="20"
                  style="-fx-background-color: linear-gradient(to right, #0FA5A2, #1D4D7C); -fx-padding: 20 30;">
                <Label text="✨ Premium Subscription" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="← Back to Main" onAction="#handleBackToMain"
                        style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 25; -fx-cursor: hand;"/>
            </HBox>

            <!-- User Info Bar -->
            <HBox spacing="30" style="-fx-background-color: white; -fx-padding: 15 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 0);"
                  alignment="CENTER_LEFT">
                <VBox spacing="5">
                    <Label text="User" style="-fx-font-size: 12px; -fx-text-fill: #999;"/>
                    <Label fx:id="usernameLabel" text="username" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1D4D7C;"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="Email" style="-fx-font-size: 12px; -fx-text-fill: #999;"/>
                    <Label fx:id="emailLabel" text="email@example.com" style="-fx-font-size: 14px; -fx-text-fill: #666;"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="Current Plan" style="-fx-font-size: 12px; -fx-text-fill: #999;"/>
                    <Label fx:id="currentPlanLabel" text="Standard Member" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #666;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="15" alignment="CENTER_RIGHT">
                    <Circle radius="15" fill="#FEC74C"/>
                    <Label text="Your Coins:" style="-fx-font-size: 14px; -fx-text-fill: #666;"/>
                    <Label fx:id="coinsCountLabel" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #FEC74C;"/>
                </HBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true"
                    style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-background-insets: 0;">
            <VBox spacing="30" style="-fx-padding: 30; -fx-background-color: transparent;">

                <!-- Premium Plans Section - Card Based Design -->
                <VBox spacing="20" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 15, 0, 0, 0);">

                    <!-- Header -->
                    <VBox spacing="10" alignment="CENTER">
                        <Label text="✨ Choose Your Premium Plan ✨"
                               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1D4D7C;"/>
                        <Label text="Unlock exclusive features and benefits"
                               style="-fx-font-size: 16px; -fx-text-fill: #666;"/>
                        <Separator style="-fx-padding: 10 0 0 0;"/>
                    </VBox>

                    <!-- Premium Plans Cards -->
                    <HBox spacing="20" alignment="CENTER" style="-fx-padding: 20 0;">

                        <!-- PREMIUM PLAN -->
                        <VBox spacing="15" style="-fx-background-color: #f8f9fa; -fx-padding: 25; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 0);"
                              HBox.hgrow="ALWAYS" prefWidth="300">

                            <StackPane alignment="TOP_CENTER">
                                <Label text="⭐ PREMIUM" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0FA5A2; -fx-alignment: center;"/>
                            </StackPane>

                            <HBox alignment="CENTER" spacing="5">
                                <Label text="29DT" style="-fx-font-size: 42px; -fx-font-weight: bold; -fx-text-fill: #1D4D7C;"/>
                                <Label text="/month" style="-fx-font-size: 14px; -fx-text-fill: #999;"/>
                            </HBox>

                            <Separator/>

                            <VBox spacing="12" style="-fx-padding: 10 0;">
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Label text="✓" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2ecc71;"/>
                                    <Label text="Change username anytime" style="-fx-font-size: 14px; -fx-text-fill: #333;" wrapText="true"/>
                                </HBox>
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Label text="✓" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2ecc71;"/>
                                    <Label text="Get 1 coin every 30 seconds" style="-fx-font-size: 14px; -fx-text-fill: #333;" wrapText="true"/>
                                </HBox>
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Label text="✓" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2ecc71;"/>
                                    <Label text="10 bonus coins on signup" style="-fx-font-size: 14px; -fx-text-fill: #333;" wrapText="true"/>
                                </HBox>
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Label text="✓" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2ecc71;"/>
                                    <Label text="Priority customer support" style="-fx-font-size: 14px; -fx-text-fill: #333;" wrapText="true"/>
                                </HBox>
                            </VBox>

                            <Region VBox.vgrow="ALWAYS"/>

                            <Button fx:id="premiumPlanBtn" text="GET PLAN" onAction="#handlePremiumPlan"
                                    style="-fx-background-color: #0FA5A2; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 12 20; -fx-background-radius: 25; -fx-cursor: hand;"
                                    maxWidth="Infinity"/>
                        </VBox>

                        <!-- VIP PLAN - Featured/Higlighted -->
                        <VBox spacing="15" style="-fx-background-color: linear-gradient(to bottom, #0FA5A2, #1D4D7C); -fx-padding: 30 25; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 15, 0, 0, 0);"
                              HBox.hgrow="ALWAYS" prefWidth="300">

                            <!-- Popular Badge -->
                            <StackPane alignment="TOP_RIGHT">
                                <Label text="🔥 BEST VALUE"
                                       style="-fx-background-color: #FEC74C; -fx-text-fill: #1D4D7C; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 5 10; -fx-background-radius: 20;"
                                       translateX="10" translateY="-10"/>
                            </StackPane>

                            <Label text="👑 VIP" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white; -fx-alignment: center;"/>

                            <HBox alignment="CENTER" spacing="5">
                                <Label text="59DT" style="-fx-font-size: 42px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                                <Label text="/month" style="-fx-font-size: 14px; -fx-text-fill: rgba(255,255,255,0.8);"/>
                            </HBox>

                            <Separator style="-fx-background-color: rgba(255,255,255,0.3);"/>

                            <VBox spacing="12" style="-fx-padding: 10 0;">
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Label text="✓" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                                    <Label text="Change username anytime" style="-fx-font-size: 14px; -fx-text-fill: white;" wrapText="true"/>
                                </HBox>
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Label text="✓" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                                    <Label text="Get 5 coins every 30 seconds" style="-fx-font-size: 14px; -fx-text-fill: white;" wrapText="true"/>
                                </HBox>
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Label text="✓" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                                    <Label text="20 bonus coins on signup" style="-fx-font-size: 14px; -fx-text-fill: white;" wrapText="true"/>
                                </HBox>
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Label text="✓" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                                    <Label text="2% discount on all bookings" style="-fx-font-size: 14px; -fx-text-fill: white;" wrapText="true"/>
                                </HBox>
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Label text="✓" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                                    <Label text="Priority customer support" style="-fx-font-size: 14px; -fx-text-fill: white;" wrapText="true"/>
                                </HBox>
                            </VBox>

                            <Region VBox.vgrow="ALWAYS"/>

                            <Button fx:id="vipPlanBtn" text="GET PLAN" onAction="#handleVIPPlan"
                                    style="-fx-background-color: #FEC74C; -fx-text-fill: #1D4D7C; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 12 20; -fx-background-radius: 25; -fx-cursor: hand;"
                                    maxWidth="Infinity"/>
                        </VBox>

                        <!-- VIP+ PLAN -->
                        <VBox spacing="15" style="-fx-background-color: #f8f9fa; -fx-padding: 25; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 0);"
                              HBox.hgrow="ALWAYS" prefWidth="300">

                            <Label text="💎 VIP+" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0FA5A2; -fx-alignment: center;"/>

                            <HBox alignment="CENTER" spacing="5">
                                <Label text="99DT" style="-fx-font-size: 42px; -fx-font-weight: bold; -fx-text-fill: #1D4D7C;"/>
                                <Label text="/month" style="-fx-font-size: 14px; -fx-text-fill: #999;"/>
                            </HBox>

                            <Separator/>

                            <VBox spacing="12" style="-fx-padding: 10 0;">
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Label text="✓" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2ecc71;"/>
                                    <Label text="Change username anytime" style="-fx-font-size: 14px; -fx-text-fill: #333;" wrapText="true"/>
                                </HBox>
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Label text="✓" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2ecc71;"/>
                                    <Label text="Get 5 coins every 30 seconds" style="-fx-font-size: 14px; -fx-text-fill: #333;" wrapText="true"/>
                                </HBox>
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Label text="✓" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2ecc71;"/>
                                    <Label text="25 bonus coins on signup" style="-fx-font-size: 14px; -fx-text-fill: #333;" wrapText="true"/>
                                </HBox>
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Label text="✓" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2ecc71;"/>
                                    <Label text="3% discount on all bookings" style="-fx-font-size: 14px; -fx-text-fill: #333;" wrapText="true"/>
                                </HBox>
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Label text="✓" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2ecc71;"/>
                                    <Label text="Create groups without admin confirmation" style="-fx-font-size: 14px; -fx-text-fill: #333;" wrapText="true"/>
                                </HBox>
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Label text="✓" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2ecc71;"/>
                                    <Label text="Priority customer support" style="-fx-font-size: 14px; -fx-text-fill: #333;" wrapText="true"/>
                                </HBox>
                            </VBox>

                            <Region VBox.vgrow="ALWAYS"/>

                            <Button fx:id="vipPlusPlanBtn" text="GET PLAN" onAction="#handleVIPPlusPlan"
                                    style="-fx-background-color: #0FA5A2; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 12 20; -fx-background-radius: 25; -fx-cursor: hand;"
                                    maxWidth="Infinity"/>
                        </VBox>
                    </HBox>

                    <!-- Payment Status Label -->
                    <Label fx:id="paymentStatusLabel" style="-fx-font-size: 14px; -fx-alignment: center;" visible="false" managed="false"/>
                </VBox>

                <!-- Additional Info -->
                <VBox spacing="10" style="-fx-background-color: #f0f8ff; -fx-padding: 20; -fx-background-radius: 10;">
                    <Label text="ℹ️ All Premium Plans Include:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1D4D7C;"/>
                    <Label text="• Priority customer support 24/7" style="-fx-font-size: 13px; -fx-text-fill: #333;"/>
                    <Label text="• Exclusive travel deals and offers" style="-fx-font-size: 13px; -fx-text-fill: #333;"/>
                    <Label text="• Cancel anytime" style="-fx-font-size: 13px; -fx-text-fill: #333;"/>
                    <Label text="• Secure payment" style="-fx-font-size: 13px; -fx-text-fill: #333;"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: #f0f0f0; -fx-padding: 15;">
            <Label text="© 2025 Rehletna.tn - Premium Subscription" style="-fx-font-size: 12px; -fx-text-fill: #999;"/>
        </HBox>
    </bottom>
</BorderPane>