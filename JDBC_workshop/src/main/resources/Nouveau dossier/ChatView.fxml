<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.effect.DropShadow?>

<?import javafx.scene.text.Text?>
<?import java.net.URL?>
<HBox prefHeight="800.0" prefWidth="1200.0"
      style="-fx-background-color: #EEF2F7;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.ChatView">
    <stylesheets>
        <URL value="@../styles/menu.css" />
    </stylesheets>
    <children>

        <VBox prefWidth="300.0"
              style="-fx-background-color: #FFFFFF;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 2, 0);">
            <children>

                <HBox alignment="CENTER" style="-fx-padding: 12 14 6 14;">
                    <children>
                        <TextField fx:id="searchField"
                                   promptText="🔍  Rechercher..."
                                   style="-fx-background-color: #F0F4F8;
                                          -fx-background-radius: 12;
                                          -fx-border-color: transparent;
                                          -fx-padding: 9 14 9 14;
                                          -fx-font-size: 13;
                                          -fx-text-fill: #2c3e50;
                                          -fx-prompt-text-fill: #9EAFC2;"
                                   HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>

                <HBox spacing="8.0" alignment="CENTER_LEFT"
                      style="-fx-padding: 4 14 12 14;">
                    <children>
                        <ToggleButton fx:id="btnAll" mnemonicParsing="false"
                                      selected="true" onAction="#handleFilterChange"
                                      text="Toutes" prefWidth="90.0" prefHeight="30.0"
                                      style="-fx-background-radius: 8; -fx-font-size: 12; -fx-cursor: hand;">
                            <toggleGroup>
                                <ToggleGroup fx:id="categoryGroup" />
                            </toggleGroup>
                        </ToggleButton>
                        <ToggleButton fx:id="btnGroups" mnemonicParsing="false"
                                      onAction="#handleFilterChange"
                                      text="Groupes" prefWidth="90.0" prefHeight="30.0"
                                      toggleGroup="$categoryGroup"
                                      style="-fx-background-radius: 8; -fx-font-size: 12; -fx-cursor: hand;" />
                    </children>
                </HBox>

                <ListView fx:id="listConversations"
                          VBox.vgrow="ALWAYS"
                          style="-fx-background-color: transparent;
                                 -fx-border-color: transparent;
                                 -fx-padding: 0;" />

            </children>
        </VBox>
        <StackPane HBox.hgrow="ALWAYS">
            <children>

                <VBox fx:id="paneDefault" alignment="CENTER" spacing="18.0"
                      style="-fx-background-color: #EEF2F7;"
                      managed="true" visible="true">
                    <children>

                        <StackPane maxWidth="-Infinity" maxHeight="-Infinity">
                            <children>
                                <Circle radius="52" fill="#E3ECF7" />
                                <Label text="💬" style="-fx-font-size: 48;" />
                            </children>
                        </StackPane>

                        <Label text="Bienvenue sur Rehletna" textFill="#0D3B66">
                            <font><Font name="System Bold" size="24.0" /></font>
                        </Label>
                        <Label text="Sélectionnez une conversation ou commencez-en une nouvelle"
                               textFill="#7f8c8d" wrapText="true" maxWidth="340" alignment="CENTER">
                            <font><Font size="13.5" /></font>
                        </Label>

                        <HBox spacing="12" alignment="CENTER">
                            <children>
                                <Button fx:id="btnNewChat" prefWidth="165.0" prefHeight="42.0"
                                        mnemonicParsing="false" onAction="#handleNewChat"
                                        text="＋ Nouveau Contact"
                                        style="-fx-background-color: #0D3B66;
                                               -fx-text-fill: white;
                                               -fx-background-radius: 10;
                                               -fx-font-weight: bold;
                                               -fx-font-size: 13;
                                               -fx-cursor: hand;
                                               -fx-effect: dropshadow(gaussian, rgba(13,59,102,0.3), 8, 0, 0, 3);" />

                                <Button fx:id="btnNewGroup" prefWidth="165.0" prefHeight="42.0"
                                        mnemonicParsing="false" onAction="#handleNewGroup"
                                        text="＋ Créer un Groupe"
                                        style="-fx-background-color: #10A5A5;
                                               -fx-text-fill: white;
                                               -fx-background-radius: 10;
                                               -fx-font-weight: bold;
                                               -fx-font-size: 13;
                                               -fx-cursor: hand;
                                               -fx-effect: dropshadow(gaussian, rgba(16,165,165,0.3), 8, 0, 0, 3);" />
                            </children>
                            <VBox.margin><Insets top="8.0" /></VBox.margin>
                        </HBox>

                        <HBox spacing="8" alignment="CENTER" maxWidth="420">
                            <children>
                                <TextField fx:id="userSearchField" managed="false" visible="false"
                                           maxWidth="360.0"
                                           promptText="🔍  Rechercher par nom, prénom ou email..."
                                           style="-fx-background-color: white;
                                                  -fx-background-radius: 10;
                                                  -fx-border-color: #D5DDE8;
                                                  -fx-border-radius: 10;
                                                  -fx-padding: 9 14 9 14;
                                                  -fx-font-size: 13;
                                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 6, 0, 0, 2);">
                                    <VBox.margin><Insets bottom="4.0" /></VBox.margin>
                                </TextField>
                                <Button fx:id="btnConfirmGroup" onAction="#handleConfirmGroupSelection"
                                        text="Valider" visible="false" managed="false"
                                        prefHeight="38.0" prefWidth="75.0"
                                        style="-fx-background-color: #10A5A5;
                                               -fx-text-fill: white;
                                               -fx-background-radius: 10;
                                               -fx-font-weight: bold;
                                               -fx-cursor: hand;" />
                            </children>
                        </HBox>

                        <ListView fx:id="listAllUsers" managed="false" maxWidth="420.0"
                                  prefHeight="280.0" visible="false"
                                  style="-fx-background-color: white;
                                         -fx-background-radius: 12;
                                         -fx-border-color: #D5DDE8;
                                         -fx-border-radius: 12;
                                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 3);" />

                    </children>
                </VBox>

                <VBox fx:id="chatArea" managed="false" visible="false"
                      style="-fx-background-color: #EEF2F7;">
                    <children>

                        <HBox alignment="CENTER_LEFT" prefHeight="64.0"
                              style="-fx-background-color: white;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 8, 0, 0, 2);
                                     -fx-padding: 0 12 0 20;">
                            <children>
                                <StackPane fx:id="headerAvatarPane" prefWidth="42" prefHeight="55" minWidth="42" minHeight="48" >
                                    <children>
                                        <!-- Le cercle de fond (on change la couleur pour le Teal de ta liste) -->
                                        <Circle fx:id="profileCircle" radius="21" fill="#10A5A5" />

                                        <!-- Le texte des initiales (on ajoute un fx:id pour le remplir dynamiquement) -->
                                        <Text fx:id="profileInitials" fill="WHITE" text="??">
                                            <style>-fx-font-weight: bold; -fx-font-size: 14px;</style>
                                        </Text>

                                        <!-- Ton indicateur de statut (inchangé, juste ajusté en position) -->
                                        <Circle fx:id="circleStatus" fill="#2ecc71" radius="6.0"
                                                stroke="WHITE" strokeType="INSIDE" strokeWidth="2.0"
                                                translateX="14" translateY="14">
                                            <effect><DropShadow color="#2ecc7166" radius="4.0" /></effect>
                                        </Circle>
                                    </children>
                                </StackPane>

                                <!-- Nom + statut -->
                                <VBox spacing="2.0" alignment="CENTER_LEFT">
                                    <HBox.margin><Insets left="8.0" /></HBox.margin>
                                    <children>
                                        <Label fx:id="lblNomContact" text="Contact" textFill="#0D3B66">
                                            <font><Font name="System Bold" size="15.0" /></font>
                                        </Label>
                                    </children>
                                </VBox>

                                <Pane HBox.hgrow="ALWAYS" />

                                <!-- Menu options -->
                                <MenuButton fx:id="btnOptions"
                                            styleClass="btn-options"
                                            mnemonicParsing="false"
                                            style="-fx-background-color: transparent;
                                            -fx-cursor: hand;
                                            -fx-background-radius: 8;" text="">
                                    <graphic>
                                        <Label text="⋮" style="-fx-font-size: 22; -fx-text-fill: rgba(255,255,255,0.7);" />
                                    </graphic>
                                    <items></items>
                                </MenuButton>
                            </children>
                        </HBox>

                        <!-- Zone des messages + bouton scroll flottant -->
                        <StackPane VBox.vgrow="ALWAYS">
                            <children>

                                <ScrollPane fx:id="scrollPaneMessages"
                                            hbarPolicy="NEVER"
                                            fitToWidth="true"
                                            fitToHeight="false"
                                            style="-fx-background-color: transparent;
                                                   -fx-background: transparent;
                                                   -fx-background-image: url('/images/back3.png');
                                                   -fx-background-repeat: no-repeat;
                                                   -fx-background-size: cover;
                                                   -fx-background-position: center center;" >
                                    <content>
                                        <VBox fx:id="vboxMessages" spacing="8.0"
                                              style="-fx-background-color: transparent;">
                                            <padding>
                                                <Insets bottom="12.0" left="18.0" right="18.0" top="12.0" />
                                            </padding>
                                        </VBox>
                                    </content>
                                </ScrollPane>

                                <!-- Bouton scroll vers le bas (flottant) -->
                                <VBox fx:id="paneScrollDown"
                                      alignment="BOTTOM_RIGHT"
                                      pickOnBounds="false"
                                      maxWidth="-Infinity"
                                      maxHeight="-Infinity"
                                      StackPane.alignment="BOTTOM_RIGHT"
                                      style="-fx-background-color: transparent;"
                                      visible="false">
                                    <children>
                                        <StackPane maxHeight="-Infinity" maxWidth="-Infinity"
                                                   onMouseClicked="#scrollToBottom"
                                                   style="-fx-cursor: hand;">
                                            <children>
                                                <Circle fill="WHITE" radius="22.0" stroke="#E0E8F0" strokeWidth="1.5">
                                                    <effect><DropShadow color="#00000022" radius="12.0" /></effect>
                                                </Circle>
                                                <Label text="↓" style="-fx-text-fill: #0D3B66; -fx-font-size: 16; -fx-font-weight: bold;" />
                                                <Label fx:id="lblNewMsgBadge" alignment="CENTER"
                                                       minHeight="18.0" minWidth="18.0" text="1"
                                                       visible="false" managed="false"
                                                       style="-fx-background-color: #10A5A5;
                                                              -fx-text-fill: white;
                                                              -fx-background-radius: 10;
                                                              -fx-font-size: 9;
                                                              -fx-font-weight: bold;
                                                              -fx-translate-y: -16;
                                                              -fx-translate-x: 16;" />
                                            </children>
                                        </StackPane>
                                    </children>
                                    <padding><Insets bottom="14.0" right="14.0" /></padding>
                                </VBox>

                            </children>
                        </StackPane>

                        <!-- Zone de saisie -->
                        <HBox fx:id="inputArea" alignment="CENTER" prefHeight="75.0" spacing="8.0"
                              style="-fx-background-color: white;
                                     -fx-border-color: #E8EEF4;
                                     -fx-border-width: 1 0 0 0;
                                     -fx-padding: 0 14 0 14;">
                            <children>

                                <!-- Bouton pièce jointe -->
                                <Button fx:id="btnAddFile" mnemonicParsing="false"
                                        onAction="#handleAttachFile"
                                        prefHeight="42.0" prefWidth="42.0"
                                        style="-fx-background-color: #E3ECF7;
                                               -fx-background-radius: 10;
                                               -fx-text-fill: #0D3B66;
                                               -fx-font-weight: bold;
                                               -fx-font-size: 17;
                                               -fx-cursor: hand;"
                                        text="＋">
                                    <HBox.margin><Insets right="2.0" /></HBox.margin>
                                </Button>

                                <!-- Bouton localisation -->
                                <Button fx:id="btnLocation" mnemonicParsing="false"
                                        onAction="#handleSendLocation"
                                        prefHeight="38.0" prefWidth="38.0"
                                        style="-fx-background-color: #FFF3E0;
                                               -fx-background-radius: 10;
                                               -fx-text-fill: #F9B948;
                                               -fx-font-size: 16;
                                               -fx-cursor: hand;"
                                        text="📍">
                                    <HBox.margin><Insets right="2.0" /></HBox.margin>
                                    <tooltip><Tooltip text="Partager ma position" /></tooltip>
                                </Button>

                                <!-- Champ de texte -->
                                <TextField fx:id="inputMessage" onAction="#handleSendMessage"
                                           promptText="Écrivez votre message..."
                                           style="-fx-background-color: #F0F4F8;
                                                  -fx-background-radius: 12;
                                                  -fx-border-color: transparent;
                                                  -fx-padding: 10 14 10 14;
                                                  -fx-font-size: 13.5;
                                                  -fx-text-fill: #2c3e50;
                                                  -fx-prompt-text-fill: #9EAFC2;"
                                           HBox.hgrow="ALWAYS" />

                                <!-- Bouton envoyer -->
                                <Button fx:id="btnSend" onAction="#handleSendMessage"
                                        prefHeight="38.0" prefWidth="90.0"
                                        style="-fx-background-color: #0D3B66;
                                               -fx-text-fill: white;
                                               -fx-background-radius: 10;
                                               -fx-font-weight: bold;
                                               -fx-font-size: 13;
                                               -fx-cursor: hand;
                                               -fx-effect: dropshadow(gaussian, rgba(13,59,102,0.25), 6, 0, 0, 2);"
                                        text="Envoyer" />

                                <!-- Bouton micro -->
                                <Button fx:id="btnMic"
                                        onMousePressed="#startRecording"
                                        onMouseReleased="#stopRecording"
                                        prefHeight="38.0" prefWidth="38.0"
                                        style="-fx-background-color: #FDECEA;
                                               -fx-background-radius: 10;
                                               -fx-text-fill: #e74c3c;
                                               -fx-font-size: 16;
                                               -fx-cursor: hand;"
                                        text="🎙" />
                            </children>
                        </HBox>

                        <!-- Bandeau "Vous avez quitté" -->
                        <HBox fx:id="paneQuitte" alignment="CENTER"
                              managed="false" prefHeight="60.0"
                              style="-fx-background-color: #FFF8F0;
                                     -fx-border-color: #F9B948;
                                     -fx-border-width: 1 0 0 0;"
                              visible="false">
                            <children>
                                <Label fx:id="lblMessageQuitte"
                                       text="🚫 Vous avez quitté cette conversation"
                                       textFill="#c0392b">
                                    <font><Font name="System Italic" size="13.5" /></font>
                                </Label>
                            </children>
                        </HBox>

                    </children>
                </VBox>

            </children>
        </StackPane>

        <VBox fx:id="paneMediaHistory" prefWidth="265.0"
              managed="false" visible="false"
              style="-fx-background-color: white;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, -2, 0);">
            <children>

                <!-- En-tête panneau média -->
                <HBox alignment="CENTER_LEFT" prefHeight="64.0" spacing="10.0"
                      style="-fx-background-color: #0D3B66; -fx-padding: 0 16 0 18;">
                    <children>
                        <Label text="📎" style="-fx-font-size: 16;" />
                        <Label text="Fichiers partagés" textFill="white"
                               style="-fx-font-weight: bold; -fx-font-size: 15;" />
                        <Pane HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleCloseMedia" text="✕"
                                style="-fx-background-color: rgba(255,255,255,0.15);
                                       -fx-text-fill: white;
                                       -fx-background-radius: 8;
                                       -fx-cursor: hand;
                                       -fx-font-size: 13;" />
                    </children>
                </HBox>

                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                            style="-fx-background-color: transparent; -fx-background: #F8FAFB;">
                    <content>
                        <VBox fx:id="vboxMediaList" spacing="10.0"
                              style="-fx-padding: 14;" />
                    </content>
                </ScrollPane>

            </children>
        </VBox>

    </children>
</HBox>
