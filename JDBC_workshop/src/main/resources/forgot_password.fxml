<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<?import javafx.scene.effect.DropShadow?>
<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="controllers.ForgotPasswordController"
           prefWidth="1000" prefHeight="787">

    <!-- Background -->
    <ImageView fitWidth="1000" fitHeight="787" preserveRatio="false">
        <image>
            <Image url="@image/image11.jpg"/>
        </image>
    </ImageView>

    <Rectangle width="1000" height="787"
               fill="linear-gradient(to bottom right, rgba(25,40,75,0.45), rgba(45,35,65,0.55))"/>

    <!-- MAIN -->
    <HBox alignment="CENTER" spacing="80">

        <!-- LEFT PANEL -->
        <VBox alignment="CENTER_LEFT" spacing="20" prefWidth="400"
              style="-fx-background-color: rgba(255,255,255,0.08);
                     -fx-background-radius: 30;
                     -fx-padding: 40;">

            <HBox spacing="0">
                <Label text="Reh" style="-fx-text-fill:#0FA5A2;-fx-font-size:48px;-fx-font-weight:800;"/>
                <Label text="let" style="-fx-text-fill:#FEC74C;-fx-font-size:48px;-fx-font-weight:800;"/>
                <Label text="na.tn" style="-fx-text-fill:#1D4D7C;-fx-font-size:48px;-fx-font-weight:800;"/>
            </HBox>

            <Label text="Reset Your Password"
                   style="-fx-text-fill:white;-fx-font-size:36px;-fx-font-weight:bold;"/>

            <Label text="Don't worry! We'll help you recover your account."
                   wrapText="true"
                   style="-fx-text-fill:rgba(255,255,255,0.9);-fx-font-size:16px;"/>

        </VBox>

        <!-- FORM PANEL -->
        <StackPane prefWidth="450">

            <!-- FORGOT PASSWORD CONTAINER -->
            <VBox spacing="25" alignment="CENTER"
                  style="-fx-background-color: rgba(255,255,255,0.15);
                         -fx-background-radius: 30;
                         -fx-border-color: rgba(255,255,255,0.25);
                         -fx-border-radius: 30;"
                  fx:id="forgotPasswordContainer">

                <padding>
                    <Insets top="35" bottom="35" left="35" right="35"/>
                </padding>

                <!-- Title -->
                <Label text="🔐 Forgot Password"
                       style="-fx-text-fill:white;-fx-font-size:28px;-fx-font-weight:bold;"/>

                <!-- Step 1: Email/Username Verification -->
                <VBox fx:id="step1Container" spacing="15" alignment="CENTER" managed="true" visible="true">
                    <Label text="Step 1: Verify Your Account"
                           style="-fx-text-fill:#FEC74C;-fx-font-size:16px;-fx-font-weight:bold;"/>

                    <Label text="Enter your email or username to receive a verification code"
                           style="-fx-text-fill:rgba(255,255,255,0.9);-fx-font-size:13px;"
                           wrapText="true" alignment="CENTER"/>

                    <TextField fx:id="emailOrUsernameField" promptText="Email or Username" prefHeight="48"
                               style="-fx-background-color: rgba(255,255,255,0.20);
                                      -fx-background-radius: 24;
                                      -fx-border-radius: 24;
                                      -fx-border-color: rgba(255,255,255,0.35);
                                      -fx-text-fill: white;
                                      -fx-font-size: 14px;
                                      -fx-prompt-text-fill: rgba(255,255,255,0.75);
                                      -fx-padding: 0 18;"/>

                    <Label fx:id="verificationErrorLabel" text="" textFill="#ff5e62" style="-fx-font-size: 12px;" visible="false" managed="false"/>

                    <Button fx:id="sendCodeBtn"
                            text="Send Verification Code"
                            prefWidth="250"
                            prefHeight="48"
                            style="-fx-background-color: linear-gradient(to right,#36d1dc,#5b86e5);
                                   -fx-text-fill:white;
                                   -fx-font-weight:bold;
                                   -fx-font-size: 14px;
                                   -fx-background-radius: 24;
                                   -fx-cursor: hand;"
                            onAction="#handleSendCode"/>
                </VBox>

                <!-- Step 2: Code Verification -->
                <VBox fx:id="step2Container" spacing="15" alignment="CENTER" managed="false" visible="false">
                    <Label text="Step 2: Enter Verification Code"
                           style="-fx-text-fill:#FEC74C;-fx-font-size:16px;-fx-font-weight:bold;"/>

                    <Label text="We've sent a 6-digit code to your email"
                           style="-fx-text-fill:rgba(255,255,255,0.9);-fx-font-size:13px;"
                           wrapText="true" alignment="CENTER"/>

                    <Label fx:id="codeSentEmailLabel" text="" style="-fx-text-fill:#0FA5A2;-fx-font-size:14px;-fx-font-weight:bold;"/>

                    <!-- 6-digit code input boxes -->
                    <HBox spacing="10" alignment="CENTER">
                        <TextField fx:id="code1" prefWidth="50" prefHeight="60"
                                   style="-fx-background-color: rgba(255,255,255,0.20);
                                          -fx-background-radius: 10;
                                          -fx-border-radius: 10;
                                          -fx-border-color: rgba(255,255,255,0.35);
                                          -fx-text-fill: white;
                                          -fx-font-size: 24px;
                                          -fx-font-weight: bold;
                                          -fx-alignment: center;"/>
                        <TextField fx:id="code2" prefWidth="50" prefHeight="60"
                                   style="-fx-background-color: rgba(255,255,255,0.20);
                                          -fx-background-radius: 10;
                                          -fx-border-radius: 10;
                                          -fx-border-color: rgba(255,255,255,0.35);
                                          -fx-text-fill: white;
                                          -fx-font-size: 24px;
                                          -fx-font-weight: bold;
                                          -fx-alignment: center;"/>
                        <TextField fx:id="code3" prefWidth="50" prefHeight="60"
                                   style="-fx-background-color: rgba(255,255,255,0.20);
                                          -fx-background-radius: 10;
                                          -fx-border-radius: 10;
                                          -fx-border-color: rgba(255,255,255,0.35);
                                          -fx-text-fill: white;
                                          -fx-font-size: 24px;
                                          -fx-font-weight: bold;
                                          -fx-alignment: center;"/>
                        <TextField fx:id="code4" prefWidth="50" prefHeight="60"
                                   style="-fx-background-color: rgba(255,255,255,0.20);
                                          -fx-background-radius: 10;
                                          -fx-border-radius: 10;
                                          -fx-border-color: rgba(255,255,255,0.35);
                                          -fx-text-fill: white;
                                          -fx-font-size: 24px;
                                          -fx-font-weight: bold;
                                          -fx-alignment: center;"/>
                        <TextField fx:id="code5" prefWidth="50" prefHeight="60"
                                   style="-fx-background-color: rgba(255,255,255,0.20);
                                          -fx-background-radius: 10;
                                          -fx-border-radius: 10;
                                          -fx-border-color: rgba(255,255,255,0.35);
                                          -fx-text-fill: white;
                                          -fx-font-size: 24px;
                                          -fx-font-weight: bold;
                                          -fx-alignment: center;"/>
                        <TextField fx:id="code6" prefWidth="50" prefHeight="60"
                                   style="-fx-background-color: rgba(255,255,255,0.20);
                                          -fx-background-radius: 10;
                                          -fx-border-radius: 10;
                                          -fx-border-color: rgba(255,255,255,0.35);
                                          -fx-text-fill: white;
                                          -fx-font-size: 24px;
                                          -fx-font-weight: bold;
                                          -fx-alignment: center;"/>
                    </HBox>

                    <Label fx:id="timerLabel" text="Code expires in: 05:00" style="-fx-text-fill:#FEC74C;-fx-font-size: 14px;-fx-font-weight: bold;"/>

                    <HBox spacing="10" alignment="CENTER" style="-fx-padding: 5 0;">
                        <Label text="Didn't receive code?" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 12px;"/>
                        <Label text="Resend"
                               fx:id="resendCodeLink"
                               onMouseClicked="#handleResendCode"
                               style="-fx-text-fill: #FEC74C; -fx-underline: true; -fx-cursor: hand; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                    </HBox>

                    <Button fx:id="verifyCodeBtn"
                            text="Verify Code"
                            prefWidth="220"
                            prefHeight="48"
                            style="-fx-background-color: linear-gradient(to right,#36d1dc,#5b86e5);
                                   -fx-text-fill:white;
                                   -fx-font-weight:bold;
                                   -fx-font-size: 14px;
                                   -fx-background-radius: 24;
                                   -fx-cursor: hand;"
                            onAction="#handleVerifyCode"/>
                </VBox>

                <!-- Step 3: New Password -->
                <VBox fx:id="step3Container" spacing="15" alignment="CENTER" managed="false" visible="false">
                    <Label text="Step 3: Create New Password"
                           style="-fx-text-fill:#FEC74C;-fx-font-size:16px;-fx-font-weight:bold;"/>

                    <PasswordField fx:id="newPasswordField" promptText="New Password" prefHeight="48"
                                   style="-fx-background-color: rgba(255,255,255,0.20);
                                          -fx-background-radius: 24;
                                          -fx-border-radius: 24;
                                          -fx-border-color: rgba(255,255,255,0.35);
                                          -fx-text-fill: white;
                                          -fx-font-size: 14px;
                                          -fx-prompt-text-fill: rgba(255,255,255,0.75);
                                          -fx-padding: 0 18;"/>

                    <PasswordField fx:id="confirmNewPasswordField" promptText="Confirm New Password" prefHeight="48"
                                   style="-fx-background-color: rgba(255,255,255,0.20);
                                          -fx-background-radius: 24;
                                          -fx-border-radius: 24;
                                          -fx-border-color: rgba(255,255,255,0.35);
                                          -fx-text-fill: white;
                                          -fx-font-size: 14px;
                                          -fx-prompt-text-fill: rgba(255,255,255,0.75);
                                          -fx-padding: 0 18;"/>

                    <Label fx:id="passwordErrorLabel" text="" textFill="#ff5e62" style="-fx-font-size: 12px;" visible="false" managed="false"/>

                    <Button fx:id="resetPasswordBtn"
                            text="Reset Password"
                            prefWidth="220"
                            prefHeight="48"
                            style="-fx-background-color: linear-gradient(to right,#ff9966,#ff5e62);
                                   -fx-text-fill:white;
                                   -fx-font-weight:bold;
                                   -fx-font-size: 16px;
                                   -fx-background-radius: 24;
                                   -fx-cursor: hand;"
                            onAction="#handleResetPassword"/>
                </VBox>

                <!-- Back to Login Link -->
                <Label text="← Back to Login"
                       fx:id="backToLoginLink"
                       onMouseClicked="#handleBackToLogin"
                       style="-fx-text-fill:white;-fx-underline:true;-fx-cursor:hand;-fx-font-size: 13px;"
                       onMouseEntered="#onLinkHover"
                       onMouseExited="#onLinkExit"/>

            </VBox>

        </StackPane>

    </HBox>

</StackPane>