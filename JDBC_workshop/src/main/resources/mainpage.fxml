<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.paint.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.esprit.projet.controlles.MainPageController"
            prefWidth="1300"
            prefHeight="800"
            style="-fx-background-color: #f8faff;">

    <!-- Top Bar with Logo, Horizontal Menu and Profile -->
    <top>
        <VBox spacing="0">
            <!-- Top Bar with Logo and Profile -->
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: white; -fx-padding: 15 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 0);">
                <!-- Logo -->
                <HBox spacing="0" alignment="CENTER">
                    <Label text="Reh" textFill="#0FA5A2" style="-fx-font-size: 24px; -fx-font-weight: 900;"/>
                    <Label text="let" textFill="#FEC74C" style="-fx-font-size: 24px; -fx-font-weight: 900;"/>
                    <Label text="na.tn" textFill="#1D4D7C" style="-fx-font-size: 24px; -fx-font-weight: 900;"/>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Profile Section (Top Right) -->
                <HBox spacing="15" alignment="CENTER_RIGHT">
                    <VBox alignment="CENTER_RIGHT" spacing="2">
                        <Label fx:id="userNameLabel" text="Alexandre Voyageur" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1D4D7C;"/>
                        <Label fx:id="userRoleLabel" text="Premium Member" style="-fx-font-size: 12px; -fx-text-fill: #FEC74C; -fx-font-weight: bold;"/>
                    </VBox>

                    <StackPane>
                        <Circle fx:id="userAvatar" radius="25" fill="linear-gradient(to bottom right, #0FA5A2, #1D4D7C)" style="-fx-cursor: hand;"/>
                        <ImageView fx:id="userAvatarImage" fitWidth="50" fitHeight="50" preserveRatio="false" visible="false" style="-fx-cursor: hand;">
                            <clip>
                                <Circle radius="25" centerX="25" centerY="25"/>
                            </clip>
                        </ImageView>
                        <Circle radius="8" fill="#2ecc71" stroke="white" strokeWidth="2" translateX="15" translateY="15"/>
                    </StackPane>
                </HBox>
            </HBox>

            <!-- Horizontal Navigation Menu -->
            <HBox spacing="10" style="-fx-background-color: white; -fx-padding: 0 30 15 30; -fx-border-color: #f0f0f0; -fx-border-width: 1 0 0 0;" alignment="CENTER_LEFT">
                <!-- Dashboard Button (only visible for Admin) -->
                <Button fx:id="dashboardBtn" visible="false" managed="false"
                        style="-fx-background-color: #e6f7f5; -fx-text-fill: #0FA5A2; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 25; -fx-cursor: hand;">
                    <graphic>
                        <HBox spacing="8" alignment="CENTER">
                            <Label text="🏠" style="-fx-font-size: 16px;"/>
                            <Label text="Dashboard" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                        </HBox>
                    </graphic>
                </Button>

                <!-- Activities Button -->
                <Button fx:id="activitiesBtn"
                        style="-fx-background-color: transparent; -fx-text-fill: #666; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 25; -fx-cursor: hand;">
                    <graphic>
                        <HBox spacing="8" alignment="CENTER">
                            <Label text="🏞" style="-fx-font-size: 16px;"/>
                            <Label text="Activities" style="-fx-font-size: 14px;"/>
                        </HBox>
                    </graphic>
                </Button>

                <!-- My Bookings Button -->
                <Button fx:id="reservationsBtn"
                        style="-fx-background-color: transparent; -fx-text-fill: #666; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 25; -fx-cursor: hand;">
                    <graphic>
                        <HBox spacing="8" alignment="CENTER">
                            <Label text="📅" style="-fx-font-size: 16px;"/>
                            <Label text="My Bookings" style="-fx-font-size: 14px;"/>
                        </HBox>
                    </graphic>
                </Button>

                <!-- Messages Button -->
                <Button fx:id="messagesBtn"
                        style="-fx-background-color: transparent; -fx-text-fill: #666; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 25; -fx-cursor: hand;">
                    <graphic>
                        <HBox spacing="8" alignment="CENTER">
                            <Label text="💬" style="-fx-font-size: 16px;"/>
                            <Label text="Messages" style="-fx-font-size: 14px;"/>
                            <Circle radius="5" fill="#ff5e62" translateX="3"/>
                        </HBox>
                    </graphic>
                </Button>

                <!-- Favorites Button -->
                <Button fx:id="favoritesBtn"
                        style="-fx-background-color: transparent; -fx-text-fill: #666; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 25; -fx-cursor: hand;">
                    <graphic>
                        <HBox spacing="8" alignment="CENTER">
                            <Label text="❤" style="-fx-font-size: 16px;"/>
                            <Label text="Favorites" style="-fx-font-size: 14px;"/>
                        </HBox>
                    </graphic>
                </Button>

                <!-- Settings Button -->
                <Button fx:id="settingsBtn"
                        style="-fx-background-color: transparent; -fx-text-fill: #666; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 25; -fx-cursor: hand;">
                    <graphic>
                        <HBox spacing="8" alignment="CENTER">
                            <Label text="⚙" style="-fx-font-size: 16px;"/>
                            <Label text="Settings" style="-fx-font-size: 14px;"/>
                        </HBox>
                    </graphic>
                </Button>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Logout Button -->
                <Button fx:id="logoutBtn"
                        style="-fx-background-color: #fff0f0; -fx-text-fill: #ff5e62; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 25; -fx-background-radius: 25; -fx-cursor: hand;">
                    <graphic>
                        <HBox spacing="8" alignment="CENTER">
                            <Label text="🚪" style="-fx-font-size: 16px;"/>
                            <Label text="Logout" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                        </HBox>
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </top>

    <!-- Center Content - Empty (ready for dynamic content) -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: transparent; -fx-padding: 0;">
            <!-- Content will be loaded dynamically by the controller -->
            <!-- This area starts empty -->
        </StackPane>
    </center>
    <!-- Bottom Right Chat Button -->
    <bottom>
        <HBox alignment="BOTTOM_RIGHT" style="-fx-padding: 20;">
            <StackPane>
                <Button fx:id="chatButton" style="-fx-background-color: #0FA5A2; -fx-background-radius: 30; -fx-min-width: 60; -fx-min-height: 60; -fx-cursor: hand;">
                    <graphic>
                        <Label text="💬" style="-fx-font-size: 24px; -fx-text-fill: white;"/>
                    </graphic>
                </Button>
                <Label fx:id="chatUnreadBadge" visible="false"
                       style="-fx-background-color: #ff5e62; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 12; -fx-min-width: 24; -fx-min-height: 24; -fx-alignment: center;"
                       translateX="20" translateY="-20"/>
            </StackPane>
        </HBox>
    </bottom>
    <!-- Bottom Left Coin Collection -->
    <bottom>
        <HBox alignment="BOTTOM_LEFT" style="-fx-padding: 20;">
            <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);" prefWidth="250">
                <Label text="🪙 Coin Collection" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1D4D7C;"/>
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <ProgressIndicator fx:id="coinProgressIndicator" prefWidth="50" prefHeight="50" progress="0"/>
                    <VBox spacing="5">
                        <Label fx:id="coinCountLabel" text="0 coins" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #FEC74C;"/>
                        <Label fx:id="nextCoinTimerLabel" text="Next coin in 30s" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                        <Button fx:id="collectCoinBtn" text="COLLECT" disable="true"
                                style="-fx-background-color: #0FA5A2; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 5 15; -fx-background-radius: 20; -fx-cursor: hand;"/>
                    </VBox>
                </HBox>
            </VBox>
        </HBox>
    </bottom>

</BorderPane>