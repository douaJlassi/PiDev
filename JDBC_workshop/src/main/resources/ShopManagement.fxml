<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.esprit.projet.controlles.ShopManagementController"
            prefWidth="1000"
            prefHeight="600"
            style="-fx-background-color: #f5f5f5;">

    <top>
        <VBox spacing="0">
            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="20"
                  style="-fx-background-color: linear-gradient(to right, #0FA5A2, #1D4D7C); -fx-padding: 20 30;">
                <Label text="🛒 Shop Management" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="statusLabel" style="-fx-font-size: 14px; -fx-text-fill: white;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.5" orientation="HORIZONTAL">
            <!-- Left Side - Product List -->
            <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: white;">
                <Label text="📋 Product List" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1D4D7C;"/>

                <TableView fx:id="shopTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                        <TableColumn fx:id="nameColumn" text="Name" prefWidth="150"/>
                        <TableColumn fx:id="priceColumn" text="Price (Coins)" prefWidth="100"/>
                        <TableColumn fx:id="quantityColumn" text="Quantity" prefWidth="80"/>
                        <TableColumn fx:id="categoryColumn" text="Category" prefWidth="100"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- Right Side - Product Form -->
            <VBox spacing="20" style="-fx-padding: 20; -fx-background-color: #f8f9fa;">
                <Label text="➕ Add/Edit Product" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1D4D7C;"/>

                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;">
                    <VBox spacing="15" style="-fx-padding: 10;">

                        <!-- Name Field -->
                        <VBox spacing="5">
                            <Label text="Product Name:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #666;"/>
                            <TextField fx:id="nameField" promptText="Enter product name"
                                       style="-fx-padding: 10; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ddd;"/>
                        </VBox>

                        <!-- Description Field -->
                        <VBox spacing="5">
                            <Label text="Description:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #666;"/>
                            <TextArea fx:id="descriptionArea" promptText="Enter product description" prefRowCount="3"
                                      style="-fx-padding: 10; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ddd;"/>
                        </VBox>

                        <!-- Price Field -->
                        <VBox spacing="5">
                            <Label text="Price (Coins):" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #666;"/>
                            <TextField fx:id="priceField" promptText="Enter price in coins"
                                       style="-fx-padding: 10; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ddd;"/>
                        </VBox>

                        <!-- Quantity Field -->
                        <VBox spacing="5">
                            <Label text="Quantity:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #666;"/>
                            <TextField fx:id="quantityField" promptText="Enter quantity"
                                       style="-fx-padding: 10; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ddd;"/>
                        </VBox>

                        <!-- Category Field -->
                        <VBox spacing="5">
                            <Label text="Category:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #666;"/>
                            <TextField fx:id="categoryField" promptText="Enter category"
                                       style="-fx-padding: 10; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ddd;"/>
                        </VBox>

                        <!-- Image Upload -->
                        <VBox spacing="5">
                            <Label text="Product Image:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #666;"/>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Button fx:id="chooseImageBtn" text="📁 Choose Image"
                                        style="-fx-background-color: #0FA5A2; -fx-text-fill: white; -fx-padding: 8 15; -fx-background-radius: 8; -fx-cursor: hand;"/>
                                <ImageView fx:id="productImageView" fitWidth="80" fitHeight="80" preserveRatio="true"
                                           style="-fx-background-color: #f0f0f0; -fx-background-radius: 8; -fx-border-color: #ddd; -fx-border-radius: 8;"/>
                            </HBox>
                        </VBox>

                        <!-- Action Buttons -->
                        <HBox spacing="10" alignment="CENTER" style="-fx-padding: 20 0 0 0;">
                            <Button fx:id="addBtn" text="➕ Add Product"
                                    style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
                            <Button fx:id="updateBtn" text="✏️ Update" disable="true"
                                    style="-fx-background-color: #FEC74C; -fx-text-fill: #333; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
                            <Button fx:id="deleteBtn" text="🗑️ Delete" disable="true"
                                    style="-fx-background-color: #ff5e62; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
                            <Button fx:id="clearBtn" text="🔄 Clear"
                                    style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
                        </HBox>
                    </VBox>
                </ScrollPane>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>