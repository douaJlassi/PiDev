<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.PurchaseHistoryController"
            prefHeight="800" prefWidth="1200"
            style="-fx-background-color: #f8faff;">

    <!-- Header with gradient background -->
    <top>
        <VBox spacing="0">
            <!-- Main Header -->
            <HBox alignment="CENTER_LEFT" spacing="20"
                  style="-fx-background-color: linear-gradient(to right, #0FA5A2, #1D4D7C); -fx-padding: 20 30;">

                <Label text="📜 Purchase History"
                       style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="backBtn" text="← Back to Shop"
                        style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 25; -fx-cursor: hand;"/>
                <Button fx:id="refreshBtn" text="🔄 Refresh"
                        style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 25; -fx-cursor: hand;"/>
            </HBox>

            <!-- Stats Summary Bar -->
            <HBox spacing="30"
                  style="-fx-background-color: white; -fx-padding: 15 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 0);"
                  alignment="CENTER_LEFT">

                <HBox spacing="10" alignment="CENTER">
                    <Label text="📊" style="-fx-font-size: 20px;"/>
                    <Label fx:id="totalPurchasesLabel" text="Total: 0"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1D4D7C;"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER">
                    <Label text="💰" style="-fx-font-size: 20px;"/>
                    <Label fx:id="totalSpentLabel" text="Spent: 0 🪙"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #FEC74C;"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER">
                    <Label text="🎁" style="-fx-font-size: 20px;"/>
                    <Label fx:id="uniqueProductsLabel" text="Unique: 0"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #0FA5A2;"/>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="Your purchase history"
                       style="-fx-font-size: 12px; -fx-text-fill: #999; -fx-font-style: italic;"/>
            </HBox>

            <!-- Search and Sort Bar -->
            <HBox spacing="15" style="-fx-background-color: white; -fx-padding: 15 30; -fx-border-color: #f0f0f0; -fx-border-width: 1 0 0 0;">
                <Label text="Sort by:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #666;"/>
                <ComboBox fx:id="sortComboBox" prefWidth="150"/>

                <Region HBox.hgrow="ALWAYS"/>

                <TextField fx:id="searchField" promptText="Search orders..." prefWidth="300"
                           style="-fx-padding: 8; -fx-background-radius: 8; -fx-border-color: #ddd; -fx-border-radius: 8;"/>
                <Button fx:id="searchBtn" text="🔍 Search"
                        style="-fx-background-color: #0FA5A2; -fx-text-fill: white; -fx-padding: 8 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </top>

    <!-- Center - Table Section -->
    <center>
        <VBox spacing="15" style="-fx-padding: 25 30;">

            <!-- Title with icon -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="🛍️" style="-fx-font-size: 24px;"/>
                <Label text="My Orders"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1D4D7C;"/>
            </HBox>

            <!-- Table Container with shadow -->
            <VBox spacing="0"
                  style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">

                <TableView fx:id="purchaseTable" VBox.vgrow="ALWAYS"
                           style="-fx-background-radius: 15; -fx-border-color: transparent;">

                    <columns>
                        <TableColumn fx:id="idColumn" text="Order ID" prefWidth="80"/>
                        <TableColumn fx:id="dateColumn" text="Date" prefWidth="150"/>
                        <TableColumn fx:id="productColumn" text="Product" prefWidth="200"/>
                        <TableColumn fx:id="quantityColumn" text="Qty" prefWidth="60"/>
                        <TableColumn fx:id="priceColumn" text="Price" prefWidth="100"/>
                        <TableColumn fx:id="statusColumn" text="Status" prefWidth="100"/>
                        <TableColumn fx:id="buyerColumn" text="Buyer" prefWidth="150"/>
                        <TableColumn fx:id="actionColumn" text="Actions" prefWidth="100"/>
                    </columns>

                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <!-- Empty state message (hidden by default) -->
            <Label fx:id="emptyStateLabel" text="No purchase history found"
                   style="-fx-font-size: 14px; -fx-text-fill: #999; -fx-padding: 20; -fx-alignment: center;"
                   visible="false" managed="false"/>
        </VBox>
    </center>

    <!-- Footer -->
    <bottom>
        <HBox alignment="CENTER"
              style="-fx-background-color: white; -fx-padding: 10; -fx-border-color: #f0f0f0; -fx-border-width: 1 0 0 0;">
            <Label text="© 2025 Rehletna.tn - Your purchase history at a glance"
                   style="-fx-font-size: 11px; -fx-text-fill: #999;"/>
        </HBox>
    </bottom>

</BorderPane>